# =============================================================================
# Alerts.env — Telegram only (Phase 2 trim — Jun 18, 2026)
# =============================================================================
# Secrets: secretsprivate/telegram.env (local) or Secret Manager (prod)
# Alert levels: System.env ALERT_LEVEL_*
# OAuth renewal alerts: prime_alert_manager reads OAUTH_* from System.env / secrets
# Outbound pacing (Aug 12): never drop fill/reject — serialize + space + 429 retry
# =============================================================================

TELEGRAM_ALERTS_ENABLED=true
TELEGRAM_ENABLED=true
TELEGRAM_MAX_MESSAGES_PER_MINUTE=30
TELEGRAM_MIN_INTERVAL_SEC=1.05
TELEGRAM_SEND_MAX_RETRIES=8
ALERT_COOLDOWN_SECONDS=60
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
