# -----------------------------------------------------------------------------
# 3) Shared portfolio cap — combined options book (ORB1 Breakout + Trendline 0DTE)
# -----------------------------------------------------------------------------
# Per-path maxima live in Account0DTE.env: ORB1, ORB2, and Trendline are each 7.
# Canonical combined cap: Account0DTE.env TOTAL_0DTE_MAX_POSITIONS=7.
# Leftover alias only — keep it equal to TOTAL so it cannot disagree.
MAX_TOTAL_OPTION_POSITIONS=50
# Exec-ready signal TTL for TL QUALITY_CONFIRMED / BO READY capital-availability waits.
# ORB1 Breakout remains one-shot batch execution with no later grace window.
# Full-slot / no-slot conditions may retry until TTL; quality/structure rejects do not.
# Path overrides: *_EXEC_SIGNAL_EXPIRE_MINUTES.
# Module: modules/path_exec_ready_ttl.py
0DTE_EXEC_SIGNAL_EXPIRE_MINUTES=1
# Oct 13 2026: TTL expiry (capacity wait, no execution attempt) retires the break and
# re-arms for the next break with no 1h slot/side cooldown (label exec_ready_ttl_retired).
EXEC_READY_TTL_RETIRE_NO_COOLDOWN=false

# -----------------------------------------------------------------------------
# 4) ORB boundaries & index capture (SO + 0DTE + ORB manager consumers)
# -----------------------------------------------------------------------------
# 7:30 re-check near-break tolerance (SO LONG + 0DTE SHORT vs ORB boundaries).
ORB_BREAK_TOLERANCE=0.0005
# VIX/SPX: Yahoo 15m RTH slice for true 6:30–6:45 PT ORB.
ORB_RTH_INTRADAY_SYMBOLS=VIX,SPX

# -----------------------------------------------------------------------------
# 5) Session clocks (America/Los_Angeles) — single source for all path windows
# Module: modules/session_clock.py
# Holidays/weekends: prime_market_manager + dynamic_holiday_calculator (not this block).
# Start inclusive / end exclusive except morning-alert end (inclusive).
# Capture end = discovery start for that lane.
# 12:30 = no-new-entries (mfe_trail runs with price_trail from here);
# 12:50 = flatten leftover (retries until the book is empty / EOD report);
# 12:55 = EOD Telegram. END of the flatten window is the scheduled 1-min kick only.
# Do not re-declare these keys in ORB0DTE / Trendline0DTE / Breakout0DTE / ORBSO.
# Token expiry 21:00 PT / OAuth keep-alives stay on Cloud Scheduler (not this block).
# -----------------------------------------------------------------------------
MARKET_TIMEZONE_PT=America/Los_Angeles
MARKET_TIMEZONE_ET=America/New_York
# OAuth / Good Morning (Cloud Scheduler + loop marker). Holiday skip stays in dynamic_holiday_calculator.
MORNING_ALERT_START_PT=05:30
MORNING_ALERT_END_PT=05:35
# Live SPY probe before ORB#1 capture (must run while cash is still closed).
TOKEN_PREP_START_PT=06:25
TOKEN_PREP_END_PT=06:26
# ORB#1 capture box (geometry). Discovery does not start until this freeze + TL0 build.
ORB_WINDOW_START=06:30
ORB_WINDOW_END=06:45
# ORB#2 first-hour box. Freeze at CAPTURE_ORB2_END_PT (same instant as ORB2 discovery start).
CAPTURE_ORB2_START_PT=06:30
CAPTURE_ORB2_END_PT=07:30
# TL0 + ORB1 Breakout discovery (after ORB1 capture → Yahoo 1m → TL0 inject).
# End exclusive: no new ORB1/TL0 entries at/after 07:25. 07:25–07:30 is the
# ORB#2 capture gap (no ORB1/TL0, no TL1+). TL1–TL2+ / ORB2 BO open at 07:30.
DISCOVERY_ORB1_TL0_START_PT=06:45
DISCOVERY_ORB1_TL0_END_PT=07:25
# TL1 / TL2 / TL3 + ORB2 Breakout discovery (after ORB2 capture). No new entries after end.
DISCOVERY_ORB2_TL_START_PT=07:30
DISCOVERY_ORB2_TL_END_PT=12:30
# Flatten leftover 0DTE (+ leftover SO). Starts at 12:50 PT and keeps retrying until
# the unified book is empty (Cloud Run restart must resume; do not stop at 12:51).
EOD_FLATTEN_START_PT=12:50
EOD_FLATTEN_END_PT=12:51
# Unified Telegram EOD (`🏦 END-OF-DAY 0DTE`). After flatten. Sole sender:
# Cloud Scheduler job end-of-day-report (cron 55 15 * * 1-5 ET) POST /api/end-of-day-report.
# The trading loop does not send this Telegram.
EOD_REPORT_START_PT=12:55
EOD_REPORT_END_PT=12:56

# -----------------------------------------------------------------------------
# 6) Execution gating · priority optimizer · telemetry (all paths)
# -----------------------------------------------------------------------------
ENABLE_SIGNAL_LEVEL_RED_DAY_FILTER=false

# --- Live 0DTE entry execution risk (ORB + Trendline lotto opens) ---
# Module: modules/dte0_execution_risk_manager.py · Resolver: modules/spread_policy.py
# Shared entry policy applies to ORB1 0DTE, ORB2 Breakout, and Trendline.
# Per-share premium: 2.50 = ~$250 contract cost before fees. Position sizing remains
# separate in Account0DTE.env (slot budget; 0DTE_MAX_POSITION_SIZE_SUM=0).
0DTE_MAX_ENTRY_PREMIUM=2.50
0DTE_MIN_ENTRY_PREMIUM=0.03
0DTE_ENTRY_DELTA_MIN=0.18
0DTE_ENTRY_DELTA_MAX=0.42
0DTE_ENTRY_MIN_VOLUME=50
0DTE_ENTRY_MIN_OPEN_INTEREST=100

# --- Entry participation admission (2026-09-27 PC V2 replay) ---
# Runs after chain hydrate, before execution.
# CALL: call_chain_volume >= 110000. Missing/non-finite rejects.
# No CALL same-side entry check.
# PUT: put_chain_volume >= 11000. Missing/non-finite rejects.
# PUT entry does not read same_side_chain_volume_5m_ago. QG_PUT_ENTRY_5M_MIN is omitted.
# Wide floors stay: same-side share > 0.10, lane volume-ratio floors, break_max 2.50.
# Chosen over strict max-net PUT 6700 because it gives up about $400 while admitting almost half as many zero-MFE trades on the 9/10-9/25 PC V2 replay.
GATE_entry_part=off
# Admit mode (Eric 10/9/2026): wide_collect = RESEARCH wide collection GATE_* stack
# (quality_gate_stack.WIDE_COLLECT_STACKS); Trade Profile 10.5 runs observe-only.
# Unset / trade_profile = Trade Profile admit (10.5).
QUALITY_GATE_ADMIT=wide_collect
QG_CALL_ENTRY_CHAIN_MIN=110000
QG_PUT_ENTRY_CHAIN_MIN=11000
# Delta Moon remains implemented but disabled for this architecture.
# Omit QG_CALL_DELTA_MOON_MIN, QG_CALL_GAMMA_MOON_MIN, and QG_PUT_DELTA_MOON_MIN
# until a future certified Delta Moon key is identified.

# --- Absolute CALL / PUT Skip Signals (all paths) ---
# Operator source: docs/Configs.md (Quality Gate + Skip Signal keys).
# Code reads these levels — do not hardcode dump pockets in quality_gate_stack.py.
# Extra reject on top of wide collect (dir% >0.10 · vol floor) and entry_part.
# Missing stamps do not skip.
# 2026-09-24: four CALL pockets that repeat the 7,000 entry rule are OFF
# (keys omitted): RSI+cum_vol, spread+small chain, put_chain<=435, volume_5m<=24183.
# 2026-09-24 PATH_V2 replay: these pockets are fully inside the new 9.24 skips
# and are OFF (keys omitted):
#   CALL dir_pct_change_5m >= 0.21953
#   CALL relative_volume_time_adjusted <= 0.441022
#   CALL representative_ask <= 0.05
#   PUT volume_1m <= 11763 AND call_chain_open_interest <= 21037
# 2026-09-27 remine on 9/10-9/25 PC V2 replay. Local until deploy now.
# CALL: retire C1 price_volume_efficiency_3m >= 0.549; it cost -$7,762
# after Entry on this book. Keep C2 only. Missing does not skip.
# CALL skip:
#   (break_distance_pct <= 0.00086)
# Eric 10/9 17:16 PT: CALL/PUT Skip Signals ON (hard) on wide collect. Path SS stays off (Sep 4 wide collect).
# Eric 10/15 2026: the CALL/PUT Skip Signals skip NO wins. They block only the
# extreme losing tail (0 winners cut on the 10.5 book and the 8/19-10/14 Total book).
# The app admits on the Trade Profile (wide or 10.5); these run between the chain and the contract pick.
# C2 (break_distance_pct <= 0.00086) and R-PUT (call_chain_volume >= 18800 AND
# break_distance_orb_ratio <= 0.287) are RETIRED: they cut 38 winning 10.5 trades.
# A key that is absent or blank is off (_env_float_opt -> None); no code default.
#   QG_CALL_SS_BREAK_DIST_MAX=0.00086        (retired 10/15, C2)
#   QG_PUT_SS_CALL_CHAIN_MIN=18800           (retired 10/15, R-PUT)
#   QG_PUT_SS_BREAK_ORB_RATIO_MAX=0.287      (retired 10/15, R-PUT)
# CALL skip: none. The deep CALL skip is off (no level cuts zero wins and blocks meaningful loss).
GATE_call_ss=hard
QG_CALL_SS_BREAK_DIST_GE=
# PUT skip: break_distance_pct >= 0.055 (above the max 10.5 / Total PUT winner, 0.05456).
# A missing break_distance_pct does not skip. Reason: skip_signal:put:break_dist_ge.
GATE_put_ss=hard
QG_PUT_SS_BREAK_DIST_GE=0.055
# Strategy/side 0-MFE Skip Signals (SSORB1CALL · SSTL1PUT · …). Same pre-exec
# step as CALL/PUT SS. Reject if either absolute side skip OR this path/side knife
# matches. Printed knives live in quality_gate_stack.py; optional override:
# QG_PATH_SS_ORB1_CALL=rsi>=90|volume_3m<=14244
# Path SS OFF until more win/loss fills for a remine. 9.21 knives stay in
# quality_gate_stack.py but do not hard-reject. CALL/PUT SS stay hard.
# Missing stamps do not skip. Path SS PO reject snapshots stay OFF.
# Wide collect dir%/vol floors stay.
GATE_path_ss=off
# Path SS reject snapshots off (path_ss step itself is off; CALL/PUT SS still run).
EASY_CAPTURE_PATH_SS_REJECT_SNAPSHOTS=0
# Spread caps: ORB → 0DTE_SINGLE_LEG_DIRECTIONAL_MAX_SPREAD_PCT (ORB0DTE.env)
#              Trendline → TRENDLINE_OPTION_MAX_SPREAD_PCT (Trendline0DTE.env)
# LIVE_MAX_SPREAD_PCT removed — path-owned caps (no global broker MIN)
# Liquidity / ADV Guard only — Position Sizing remains 90% capital / equal slots upstream.
# 0 / none turns the contract-count clamp off. Dollar sum sizes the open.
# v1.6: volume qty cap off (0 = disabled; no fail-closed on missing volume).
# 0 = no contract-count floor.
# v1.5/v1.6: OI is not a qty cap (0 = disabled; no fail-closed on missing OI).
# Sep 9: ask-depth qty cap OFF (0). Was v1.7 temporary 200% of displayed ask.
# v1.5/v1.6: bid is MQ evidence only (LIVE_MIN_BID_SIZE). 0 = no bid qty cap.
# Option notional (qty×ask×100) ≤ ADV$ × pct. Fail-closed if ADV unknown when pct > 0.
# Broker-token-first ADV$ (E*TRADE averageVolume×last). Yahoo only if true.
# 0 = no generic watchlist floor (fail-closed after broker + named floors).
# Aug 21: 5 → 1 so clean 1-lot quotes clear MQ while spread/OI/volume gates remain active.
LIVE_MIN_ASK_SIZE=1
LIVE_MIN_BID_SIZE=1

# --- Live close hardening (ORB1 Breakout + Trendline 0DTE) ---

# --- 6a) Priority optimizer — execution snapshots (entry research) ---
# Doc: docs/PriorityOptimizer.md · retrieve: priority_optimizer/retrieve_execution_snapshots.py
ENABLE_EXECUTION_FEATURE_SNAPSHOT=true
ENABLE_TRENDLINE_BREAK_SNAPSHOT=true
# Superseded by trendline_break_snapshots/*_breaks.json + execution_snapshots/*_trendline_*.json (Rev 00401)
ENABLE_TRENDLINE_LEGACY_JSONL_DATASET=false
# Superseded by orb_0dte_execution_window_input + unified 0DTE execution snapshots
0DTE_PRIORITY_COLLECTOR_ENABLED=false
# Research-only post-break outcome file (priority_optimizer/trendline_outcomes/*_outcomes.jsonl)
ENABLE_TRENDLINE_OUTCOME_TRACKER=false
EXECUTION_SNAPSHOT_KEEP_SESSIONS=2
EXECUTION_SNAPSHOT_LOCAL=false
# Mid-trade Profit Capture research snapshots (record-only; Research default on).
# Final never arms. Flags off returns the app to handoff / 20p / exit only.
# 50p is retired (Oct 23, 2026); older objects may still exist on disk.
PO_SNAP_AGE120_ENABLED=true
PO_SNAP_FIRST_RED_ENABLED=true
PO_SNAP_PULLBACK_ENABLED=true
# Pullback ladder (Oct 23, 2026): up to 4 shots per trade, each its own sealed object
# <trade_id>__pullback_s{n}. H = running max bid return. Shot 1 arms at H>=ARM_H and fires on
# the first tick (before the exit tick) with r <= H - dip; dip = max(MIN_DIP, LOW_K*H) for
# H < BAND_H else max(MIN_DIP, HI_K*H). After shot n: Hmin = max(NEXT_MIN_H, H_fire+NEXT_MIN_ADD,
# H_fire*NEXT_MULTS[n-1]); the next shot fires on the first dip after H >= Hmin. One frozen
# hub read per shot (no sync refresh). Replaces PO_SNAP_PULLBACK_ARM_PEAK/DEPTH/REARM_PP/MAX_CYCLES.
PO_PB_ARM_H=0.15
PO_PB_BAND_H=0.20
PO_PB_LOW_K=0.70
PO_PB_HI_K=0.10
PO_PB_MIN_DIP=0.03
PO_PB_MAX_SHOTS=4
PO_PB_NEXT_MULTS=1.25,1.5,1.5,1.5
PO_PB_NEXT_MIN_H=0.30
PO_PB_NEXT_MIN_ADD=0.05
PO_PB_HUB_TIMEOUT_S=3
PO_SNAP_AGE_SEC=120
PO_SNAP_MAX_PER_TRADE=6
PO_SNAP_MAX_PER_MIN=40
PO_SNAP_SYNC=true
# Mid-trade / exit chain overlay: reuse cache only if ≤60s at the event clock.
0DTE_PO_EXIT_CHAIN_ALLOW_STALE_SEC=60
PRIORITY_OPTIMIZER_CLEAR_RETRIEVED_ON_STARTUP=true
PRIORITY_OPTIMIZER_DAILY_SIGNALS_RETENTION_DAYS=2

# --- 6b) Telemetry & exit monitoring (GCS writers — keep EXIT_MONITORING off in prod) ---
EXIT_MONITORING_ENABLED=false
EXIT_MONITORING_MAX_RECORDS_PER_SYMBOL=120
EXIT_MONITORING_MAX_BLOB_BYTES=512000
EXIT_MONITORING_SAMPLE_EVERY=6
TELEMETRY_JSONL_MAX_BYTES=8388608
TELEMETRY_JSONL_TAIL_LINES=10000
TELEMETRY_DISK_WARN_MB=64

# -----------------------------------------------------------------------------
# 7) Profit optimizer — read-only flight recorder (exit research; does NOT change stealth)
# -----------------------------------------------------------------------------
# Doc: profit_optimizer/README.md · Not live profit capture (see section 3 + Risk.env STEALTH_*)
# Phase Next: emit/funnel/score attribution exports (priority_optimizer/trendline_measurement/)
ENABLE_TRENDLINE_MEASUREMENT=true
# Failed-emit OCC shadow is off — leftover research is for filled profitable trades only.
ENABLE_TRENDLINE_EMIT_SHADOW=false
ENABLE_PROFIT_OPTIMIZER=true
PROFIT_OPTIMIZER_LOG_MIN_INTERVAL_SEC=30
# Each evaluated monitor tick forces one live path row.
# Sample clocks follow the monitor interval (2s, or 3s at 20+ opens).
# SHADOW_SAMPLE_SEC is the fallback before that alignment.
# Winner leftover OCC is quoted after owned evaluate on a single-flight task
# off the owned lock. Closed OCC stays off the owned exit batch
# (0DTE_MAX_SHADOW_QUOTES_WHILE_OPEN=0). Tape must be dense enough for PX2 /
# trail / giveback review — do not skip leftover because owned was slow.
PROFIT_OPTIMIZER_SHADOW_SAMPLE_SEC=2
PROFIT_OPTIMIZER_EARLY_WINDOW_SECONDS=1800
PROFIT_OPTIMIZER_GCS_SYNC=true
PROFIT_OPTIMIZER_GCS_RETENTION_DAYS=2
PROFIT_OPTIMIZER_JSON_COMPACT=true
PROFIT_OPTIMIZER_SHADOW_PATH_AFTER_EXIT=true
# Winning exits keep shadow through session EOD flatten start (EOD_FLATTEN_START_PT 12:50).
# Losing / flat exits do not shadow (PROFIT_OPTIMIZER_LOSS_SHADOW_SECONDS=0).
# 0 = quote every profitable leftover (losers never enroll). Ranked leftover cap is unused at 0.
# PROFIT_OPTIMIZER_RECORDING_WINDOW_SECONDS is fallback if the session clock import fails.
PROFIT_OPTIMIZER_RECORDING_WINDOW_SECONDS=18000
PROFIT_OPTIMIZER_LOSS_SHADOW_SECONDS=0
PROFIT_OPTIMIZER_MAX_SHADOW_CONTINUATIONS=0
# RAM safety ceiling only (~recording window / 2s). Never stride the 2s series.
PROFIT_OPTIMIZER_MAX_PATH_SAMPLES=20000
# Daily JSON is metrics-only. 2s paths live in profit_optimizer/paths/{date}/*.jsonl.
# Oct 17 2026 (Eric): 12 MB -> 32 MB (code clamp max). 10/16 hit 12.02 MB at 144 trades and the GCS
# copy stopped (156 traded). ~83 KB/trade compact: 200 trades ~16.7 MB, 32 MB ~ 380 trades.
# Hydrate cap follows (1.25x, clamp 40 MB). Rollback: set back to 12000000 (file wins; redeploy).
PROFIT_OPTIMIZER_MAX_DAILY_JSON_BYTES=32000000
# Skip json.loads on boot when local/GCS daily is larger than this (0 = 1.25× max daily).
PROFIT_OPTIMIZER_MAX_HYDRATE_BYTES=0
# Reject live HWM updates when mark jumps more than this ratio vs prior tick (phantom quote guard).
PROFIT_OPTIMIZER_LIVE_HWM_JUMP_RATIO=3.0
# Quarantine shadow path when first post-exit premium / last live premium exceeds ratio
PROFIT_OPTIMIZER_SHADOW_FIRST_JUMP_RATIO=3.0
# Incremental GCS/local merge during session (scale-to-zero safe).
# Daily JSON rewrite stays sparse (45s). Per-trade JSONL appends every 5s.
PROFIT_OPTIMIZER_CHECKPOINT_SECONDS=90
PROFIT_OPTIMIZER_PERSIST_MIN_WRITE_GAP_SEC=45
PROFIT_OPTIMIZER_JSONL_MIN_WRITE_GAP_SEC=5
# Record Trendline 0DTE fills in profit_optimizer when Trendline execution is enabled
ENABLE_TRENDLINE_PROFIT_OPTIMIZER=true

# -----------------------------------------------------------------------------
# 8) Runtime shell (identity, modes, orchestration — keep lean; Data/Risk/Alerts own the rest)
# -----------------------------------------------------------------------------
ENVIRONMENT=development
# Canonical runtime mode: demo | live (single source of truth)
MODE=demo
BROKER=etrade
# Live launch: lotto-only until spread adapter routing is complete
LIVE_SPREADS_ENABLED=false
TRADING_MODE=demo
STRATEGY_MODE=standard
AUTOMATION_MODE=demo
TRADING_ENABLED=true
POLL_SECONDS=1.0
TZ=America/New_York
PORT=8080
DEMO_MODE_ENABLED=true
LIVE_MODE_ENABLED=false
LOG_LEVEL=INFO

0DTE_STRICT_EXIT_GRADE_ENABLED=true
0DTE_EOD_RECONCILIATION_ENABLED=true
0DTE_EOD_FAIL_ON_UNEXPLAINED_MISMATCH=true
0DTE_PROFIT_RETENTION_TELEMETRY_ENABLED=true
0DTE_OWNERSHIP_SYNC_TARGET_SEC=2
0DTE_OWNERSHIP_BLOCK_WARNING_SEC=3
0DTE_OWNERSHIP_BLOCK_CRITICAL_SEC=5
0DTE_OWNERSHIP_URGENT_SYNC_TIMEOUT_SEC=2
