# =============================================================================
# Shared.env — cross-path orchestration (all execution paths)
# =============================================================================
# Loaded after: Data.env · before: ORBSO.env, ORB0DTE.env, Trendline0DTE.env, Risk.env, Alerts.env
#
# SECTION TAXONOMY (see configs/README.md · docs/Configs.md)
#   1  Cross-path runtime (system mode, execution shell)
#   2  Options data policy + open-position broker budget (2s cadence)
#   3  Profit capture — options stealth (ORB + Trendline + Breakout)
#   4  Portfolio caps
#   5  Session clocks (PT) — capture + discovery + morning alert
#   6  Execution gating · priority optimizer · telemetry
#   7  Profit optimizer (read-only flight recorder — research only)
#   8  Runtime shell (MODE, broker, logging)
#
# Path toggles live in path files (last-wins):
#   RESEARCH: ORBSO.env (ORB SO ETF Demo) / ORB0DTE / Trendline0DTE / Breakout0DTE
#   FINAL:    no ORBSO — morning capture via Shared ENABLE_ORB_STRATEGY + ORB0DTE/TL/BO
# ORB SO ETF profit capture (STEALTH_*): Risk.env · Portfolio protection: ORBSO.env
# Account / broker / deploy: Data.env + Account0DTE.env · Alerts: Alerts.env
# =============================================================================

# -----------------------------------------------------------------------------
# 1) True cross-path runtime (signal routing, modes, automation shell)
# -----------------------------------------------------------------------------
SYSTEM_MODE=full_trading
ENABLE_SMART_EXECUTION=true
USE_MARKET_ORDERS=false
EXEC_LAST_LOOK_MAX_SPREAD_PCT=2.5

# -----------------------------------------------------------------------------
# 2) Options data policy (ORB1 Breakout + Trendline 0DTE consumers)
# -----------------------------------------------------------------------------
# Enforce real broker option data for DEMO and LIVE.
REQUIRE_LIVE_OPTION_DATA=true
0DTE_ALLOW_SYNTHETIC_EXIT_QUOTES=false
0DTE_DEMO_SYNTHETIC_CHAIN=false
# Unified exit monitor (ORB + Trendline + Breakout); path files may override last-wins.
0DTE_UNIFIED_POSITION_MONITOR_ENABLED=true
# Open-position monitor for ORB + Trendline + Breakout (unified maybe_tick).
# 2s below 20 opens. At 20+ the tick and the flight-recorder sample clock are 3s.
0DTE_POSITION_MONITOR_INTERVAL_SEC=2
0DTE_MONITOR_WIDE_OPEN_COUNT=20
0DTE_MONITOR_WIDE_INTERVAL_SEC=3
0DTE_EXIT_QUOTE_MODE=exact_contract_batch
0DTE_EXIT_QUOTE_TIMEOUT_SEC=1.5
0DTE_EXIT_QUOTE_MAX_AGE_SEC=8
# Non-0DTE (Fri/weekly) open positions: looser exit-quote age when mixed with 0DTE.
NON_0DTE_EXIT_QUOTE_MAX_AGE_SEC=30
# Entry liquidity validator quote cache (seconds).
OPTION_ENTRY_LIQUIDITY_CACHE_TTL_SEC=3
0DTE_EXIT_QUOTE_BATCH_CONCURRENCY=4
# E*TRADE OCC cap is 25. 12 forced a second wave at 20 opens.
0DTE_OPEN_EXACT_QUOTE_BATCH_SIZE=25
0DTE_FORCE_CHAIN_REFRESH_BRIDGE=true
0DTE_LONG_EXIT_PRICE_FIELD=bid
0DTE_MFE_HWM_PRICE_FIELD=bid
0DTE_GIVEBACK_PRICE_FIELD=bid
0DTE_EXIT_LATCH_ENABLED=true
0DTE_BLOCKING_EXIT_TELEMETRY=false
# Canonical owner for shared OPTION_STEALTH_* / OPTION_QUOTE_* defaults (path files may still override last-wins).
OPTIONS_EXIT_PROFILE=balanced

# --- 2b) Open-position broker budget + unified 0DTE discovery scan ---
# Doc: docs/PositionMonitoring.md § Broker Data Budget
0DTE_OPEN_QUOTE_RECOVERY_MAX_ATTEMPTS_PER_TICK=2
0DTE_OPEN_QUOTE_RECOVERY_MAX_WALL_SEC=0.9
# Option-chain pacing only, and only when the exit quote is actually stale.
# 2026-10-29 median was ~1.5s, so 900 was true on most open ticks: it skipped
# break checks and capped the chain sampler without speeding the exit tape.
# 4000 matches 0DTE_UNDERLYING_FRESH_MAX_MS. The equity scan and the three
# watches do not read this.
0DTE_DISCOVERY_MAX_OPEN_QUOTE_LATENCY_MS=4000
# One equity quote scan: next 24 of 0dte_list every 10s → 118 names ≤50s.
# Quotes feed whichever discovery paths are active (ORB1 BO / TL0 morning together ~06:45–07:25 after structure; later TL1–3 / ORB2 BO).
# ORB geometry is separate: ORB1 box → TL0 + ORB1 Breakout; ORB2 box → TL1/TL2/TL3 + ORB2 Breakout.
0DTE_DISCOVERY_SYMBOLS_PER_TICK=24
0DTE_DISCOVERY_INTERVAL_SEC=10
# Cap equity quotes to one E*TRADE batch while any 0DTE is open (same 24 rotate; never extras-first).
0DTE_DISCOVERY_MAX_QUOTES_WHILE_OPEN=24
# Closed-trade leftover is quoted after owned evaluate, off the owned lock.
# Do not mix closed OCC into the owned exit batch.
0DTE_MAX_SHADOW_QUOTES_WHILE_OPEN=0
# Used by chain and watch yields. It does not cancel the 24-name / 10s discovery scan.
0DTE_DISCOVERY_OWNED_MISS_BLOCK_MIN=2
# Logged when an exit tick runs long. Every open name is still exit-checked.
0DTE_MONITOR_EVAL_BUDGET_MS=1200
# When 20+ names are open, give fair-rotate more wall time (capped 2200ms).
0DTE_MONITOR_EVAL_BUDGET_MS_OPEN20=1800
# Winner leftover OCC after owned eval: 0 = quote every enrolled winner.
# Single-flight task off the owned lock so leftover wait is not in total_cycle_ms.
# Leftover uses the same occ_fetch inflight as owned exact quotes — skip it
# while the live book is open so PATH_V2 is not evaluating exact_ok=0.
0DTE_MAX_SHADOW_LEFTOVER_PER_TICK=0
# true = skip leftover OCC while any owned name is open (peak exit cadence).
# false = leftover on the research clock even while the book is open.
0DTE_LEFTOVER_SHADOW_SKIP_WHEN_OWNED_SLOW=true
# Underlying cache contract for evaluate() (ms). Last-good usable until 8000; stale after 4000.
0DTE_UNDERLYING_FRESH_MAX_MS=4000
0DTE_UNDERLYING_LAST_GOOD_MAX_MS=8000
# Live broker last for stale owned names (skip_cache). 25 = one E*TRADE batch.
# 10–20 trade days refresh the whole book each stale tick; 200-wide research
# rotates oldest first so OCC still owns the 2s cadence.
0DTE_UNDERLYING_OWNED_REFRESH_MAX=25
# Skip sparse path chain-skew / session-tech only when the last monitor cycle
# is past the last-good quote age. 1500 was below today's normal ~4s cycle,
# so dir% and skew stayed on cache for the whole open book.
# Does not skip winner leftover OCC.
0DTE_PATH_REFRESH_SKIP_CYCLE_MS=8000
0DTE_PO_HEAVY_ENRICH_WHILE_OPEN=false
# Skip PO leftover observe only on fill-enroll ticks. 0 = never skip for book size.
0DTE_PO_CONTINUATION_MAX_OPEN=0
# Sparse call/put/dir%/delta path stamps while open (not full heavy enrich every tick).
# Live chain refresh is on the discovery loop (not owned eval). Cache-only on the 2s tick.
0DTE_PATH_CHAIN_SKEW_REFRESH_ENABLED=true
0DTE_PATH_CHAIN_SKEW_REFRESH_SEC=45
0DTE_PATH_CHAIN_SKEW_REFRESH_TIMEOUT_SEC=4
0DTE_PATH_CHAIN_SKEW_REFRESH_MAX_PER_TICK=2
0DTE_PATH_CHAIN_SKEW_REFRESH_MAX_PER_DISCOVERY=2
# Moon-hold force refreshes (15s floor) — capped so 30 opens stay under 14k/hr
0DTE_PATH_CHAIN_SKEW_FORCE_MAX_PER_TICK=4
# QG Layer C chain stays on discovery/entry. Yield to monitor; reuse cache while open.
0DTE_QG_CHAIN_CACHE_WHILE_OPEN_SEC=600
0DTE_QG_LIVE_CHAIN_MAX_PER_SCAN=8
0DTE_QG_LIVE_CHAIN_MAX_PER_SCAN_WHILE_OPEN=2
# Oct 13 2026 chain fetch manager (central_tech/chain_fetch_manager.py). false = old per-scan cap,
# dir% missing rejects, prewarm deferred by open quotes. 24 chains/min = 48 real calls (140 cap).
# Oct 17 2026 (t217u, dir5m handoff-first): 180/60/150/170, tick 5, reserve 3, burst 12, 6/tick.
# These file values WIN over Cloud Run env (main.py loads configs into os.environ): change here.
CHAIN_FETCH_MANAGER_ENABLED=true
CHAIN_FETCH_BUDGET_PER_MIN=24
CHAIN_FETCH_BURST=12
CHAIN_FETCH_LOW_PRIORITY_RESERVE=3
CHAIN_FETCH_REAL_CALLS_PER_CHAIN=2
CHAIN_FETCH_LOW_PRIORITY_SAFE_PER_MIN=150
CHAIN_FETCH_HIGH_PRIORITY_SAFE_PER_MIN=170
CHAIN_FETCH_SCAN_CEILING=24
CHAIN_FETCH_PREWARM_FLAT_BYPASS=true
CHAIN_RESAMPLE_ENABLED=true
CHAIN_RESAMPLE_INTERVAL_SEC=285
CHAIN_RESAMPLE_TICK_SEC=5
CHAIN_RESAMPLE_MAX_PER_TICK=6
CHAIN_RESAMPLE_CANDIDATE_TTL_SEC=900
CHAIN_RESAMPLE_OPEN_POSITIONS=true
DIR_PCT_DEFER_MAX_WAIT_SEC=90
# Oct 13 2026 (maxpos): adaptive chain budget = (FRACTION*HARD_CAP - last minute non-chain real calls)/CALLS_PER_CHAIN, clamped FLOOR..CEILING
CHAIN_FETCH_ADAPTIVE_BUDGET=true
CHAIN_FETCH_HARD_CAP_PER_MIN=180
CHAIN_FETCH_ADAPTIVE_CAP_FRACTION=0.85
CHAIN_FETCH_ADAPTIVE_FLOOR_PER_MIN=6
CHAIN_FETCH_ADAPTIVE_CEILING_PER_MIN=60
# Live chains recorded as real broker calls (lane=chain) toward the 140/min hard cap
CHAIN_CALLS_COUNT_TOWARD_HARD_CAP=true
# Cap-first gate check: book full -> max_open_positions_reached (no chain, no dir%, no cooldown)
MAX_OPEN_POSITIONS_PRECHECK_ENABLED=true
# Legacy (manager off) tight per-scan chain cap starts at this open count (was hard-coded 7)
0DTE_QG_LIVE_CHAIN_TIGHT_AT_OPEN=7
# Sparse MACD/SMA/RSI on live+shadow path (session 1m bars) for hold/exit review.
0DTE_PATH_SESSION_TECH_REFRESH_ENABLED=true
0DTE_PATH_SESSION_TECH_REFRESH_SEC=60
0DTE_PATH_SESSION_TECH_REFRESH_MAX_PER_TICK=4
0DTE_PATH_SESSION_TECH_FORCE_MAX_PER_TICK=4
# Per-lane Market API counters (logs every N requests; 0=disable periodic summary)
0DTE_BROKER_LANE_COUNTER_LOG_EVERY=50

# -----------------------------------------------------------------------------
# 3) Profit capture — options (ORB1 Breakout + Trendline; prime_options_stealth_trailing_tp)
# -----------------------------------------------------------------------------
# Go-to doc: docs/0DTEProfitCapture.md · Not profit_optimizer (research flight recorder).

# --- 3a) Generic OPTION_STEALTH_* (both 0DTE paths) ---
OPTION_STEALTH_DELTA_ITM_THRESHOLD=0.60
OPTION_STEALTH_DELTA_ATM_THRESHOLD=0.40
OPTION_STEALTH_TRAILING_TRIGGER_PCT=0.35
OPTION_STEALTH_BASE_TRAILING_PCT=0.22
OPTION_STEALTH_EXPLOSIVE_TRAILING_PCT=0.14
OPTION_STEALTH_MOON_TRAILING_PCT=0.10
OPTION_STEALTH_TIME_EXIT_MINUTES=12
OPTION_STEALTH_NO_PROGRESS_EXIT_MINUTES=60
# --- 2b) Unified 0DTE single-leg profit capture (ORB + Trendline singles; Call + Put) ---
# PATH_V2 REPLACE (Sep 23). Side-agnostic premium path. Frozen knobs.
# Kill switch: OPTION_PC_ARCHITECTURE=current OR OPTION_PATH_V2_ENABLED=false
# restores the legacy premium stack below.
# Afternoon mfe_trail (−10pp after 12:30) and the 12:50 EOD flatten stay on.
# Active-expansion warning is on. Hybrid premium trail is off. Legacy premium explosion trails stay implemented and off.
# A stale underlying quote older than 10s is omitted from stress and blocks the underlying-gated stale shapes and both hybrid stages.
OPTION_PC_ARCHITECTURE=path_v2
OPTION_PATH_V2_ENABLED=true
OPTION_PATH_V2_MIN_HOLD_SECONDS=120
OPTION_PATH_V2_EARLY_CUT=0.15
OPTION_PATH_V2_STRESS_THR=0.40
OPTION_PATH_V2_PROOF=0.50
# 30% up to proof: sell after a 24pp giveback from the running peak. Age is the 120s hold.
# Oct 11 gated extension: when UL drawdown is tiny and current return is still +5% to +10%,
# latch and hold the 24pp touch until 38pp or a later PC exit. 8/19-10/9 replay: Total +$4,433,
# Trade Profile +$3,045, with $0 winner harm, 0 winner->loss, and 0 worsened losses.
# Oct 1 package B: 25pp -> 24pp. On in Research Demo easy-etrade-strategy-00587-585.
OPTION_PATH_V2_GB30_ENABLED=true
OPTION_PATH_V2_GB30_MIN_MFE=0.30
OPTION_PATH_V2_GB30_GIVEBACK=0.24
OPTION_PATH_V2_GB30_EXTENSION_ENABLED=true
OPTION_PATH_V2_GB30_EXTENSION_GIVEBACK=0.38
OPTION_PATH_V2_GB30_EXTENSION_MAX_UL_DD=0.0009
OPTION_PATH_V2_GB30_EXTENSION_MIN_PRET=0.05
OPTION_PATH_V2_GB30_EXTENSION_MAX_PRET=0.10
# Oct 1 package B. Two last-in-order exits. Each runs only when no other PATH_V2 exit fired
# on the tick. Neither is held by the 120s hold. On in Research Demo easy-etrade-strategy-00587-585.
# 8/19-10/1 replay (current engine, live-style marks, fee-inclusive), package B vs Oct 1 baseline:
# Trade Profile 295 +$318 (DEV +$212, VAL +$106). Total 4,079 +$3,301 (DEV +$2,581, VAL +$720).
# Winners reduced: TP 1 (-$60). Total 5 (-$480, largest -$264). Total losers improved 29 (+$2,882).
# 32-40% timed giveback: running MFE 32% up to 40%, giveback >= 15pp, high >= 120s old, bid >= +5%.
OPTION_PATH_V2_GB32_TIMED_ENABLED=true
OPTION_PATH_V2_GB32_TIMED_MIN_MFE=0.32
OPTION_PATH_V2_GB32_TIMED_MAX_MFE=0.40
OPTION_PATH_V2_GB32_TIMED_GIVEBACK=0.15
OPTION_PATH_V2_GB32_TIMED_MIN_SEC_HWM=120
OPTION_PATH_V2_GB32_TIMED_MIN_PRET=0.05
# Deep green stop: age >= 60s, running MFE 10% up to 30%, bid return <= -65%.
OPTION_PATH_V2_DEEP_STOP_ENABLED=true
OPTION_PATH_V2_DEEP_STOP_MIN_AGE_SECONDS=60
OPTION_PATH_V2_DEEP_STOP_MIN_MFE=0.10
OPTION_PATH_V2_DEEP_STOP_MAX_MFE=0.30
OPTION_PATH_V2_DEEP_STOP_PRET=-0.65
# Oct 6 V3A (accepted 10/6; local Research only, not deployed). Three additions, each with
# its own kill switch (set *_ENABLED=false to restore package B for that piece). All three off
# reproduces package B exactly (8/19-10/5 replay: TP $84,187.31, Total -$166,709.91).
# 8/19-10/5 replay vs package B, fee-inclusive, fills at bid:
# Trade Profile 445 +$1,601 (DEV +$441, VAL +$1,160). Total 4,146 +$3,686 (DEV +$1,974, VAL +$1,712).
# Losses worsened 0. Winners turned losers 0. Winners reduced 4 (-$228; TP 1, SPY-771c-859 -$84).
# shallow_floor_stop (SF): running MFE 5% up to 10%, peak bid printed on >= 2 ticks, age >= 120s,
# bid crosses down to <= -18% after age 120s (fresh cross). Sells at the bid, checked just
# before immature_stress. Exit reason shallow_floor_stop (detail SHALLOW_FLOOR_5_10_18).
OPTION_PATH_V2_SHALLOW_FLOOR_STOP_ENABLED=true
OPTION_PATH_V2_SHALLOW_FLOOR_MIN_MFE=0.05
OPTION_PATH_V2_SHALLOW_FLOOR_MAX_MFE=0.10
OPTION_PATH_V2_SHALLOW_FLOOR_MIN_AGE_SECONDS=120
OPTION_PATH_V2_SHALLOW_FLOOR_PRET=-0.18
OPTION_PATH_V2_SHALLOW_FLOOR_MIN_PEAK_TICKS=2
OPTION_PATH_V2_SHALLOW_FLOOR_REQUIRE_FRESH_CROSS=true
# Runner timing V3A (RT): overrides the 350% runner waits below while on. Timed capture arms
# after 30s (base 60s). Profit floor waits 900s only while bid return >= +50%, else base 600s.
# Exit reasons unchanged (runner_timed_capture / runner_profit_floor); detail suffix _A30 / _G900
# marks a fire that the V3A timing allowed.
OPTION_PATH_V2_RUNNER_TIMING_V3A_ENABLED=true
OPTION_PATH_V2_RUNNER_TIMING_V3A_TIMED_MIN_ARM_AGE_SECONDS=30
OPTION_PATH_V2_RUNNER_TIMING_V3A_FLOOR_GREEN_MIN_AGE_SECONDS=900
OPTION_PATH_V2_RUNNER_TIMING_V3A_FLOOR_GREEN_MIN_PRET=0.50
# stall_floor_stop (SBE v2-A): last check, after deep_green_stop. Running MFE 15% up to 40%,
# age 60-3600s, premium high >= 1500s old. Armed after bid holds above +4% for 30s; fires on
# 2 consecutive ticks with bid <= +4%, only if bid >= +1% (floor - slip); else no fire and the
# base exits keep the trade. Exit reason stall_floor_stop (detail STALL_FLOOR_15_40_4).
OPTION_PATH_V2_STALL_FLOOR_STOP_ENABLED=true
OPTION_PATH_V2_STALL_FLOOR_MIN_MFE=0.15
OPTION_PATH_V2_STALL_FLOOR_MAX_MFE=0.40
OPTION_PATH_V2_STALL_FLOOR_MIN_AGE_SECONDS=60
OPTION_PATH_V2_STALL_FLOOR_MAX_AGE_SECONDS=3600
OPTION_PATH_V2_STALL_FLOOR_MIN_SEC_HWM=1500
OPTION_PATH_V2_STALL_FLOOR_FLOOR=0.04
OPTION_PATH_V2_STALL_FLOOR_MAX_SLIP=0.03
OPTION_PATH_V2_STALL_FLOOR_ARM_ABOVE_SECONDS=30
OPTION_PATH_V2_STALL_FLOOR_CONFIRM_TICKS=2
# Oct 6 Runner Extension (R2X; local Research only, not deployed). Own kill switch: set
# OPTION_PATH_V2_RUNNER_EXTENSION_ENABLED=false to restore V3A + SF4 exactly (8/19-10/5 replay:
# TP $85,940.31, Total -$162,045.91). On the tick where runner_timed_capture would fire (350%
# runner, bid >= +400%), it does not sell if the gap guard passes (>= 2 ticks before the touch
# and the previous tick's bid return >= 0.5 x the touch). It stores L0 = the touch bid return
# and holds; from then on only R2X can exit (STEP 1), at the first of: bid < +50% ->
# runner_extension_floor (RUNNER_EXT_FLOOR); bid >= 1.25 x L0 -> runner_extended_capture
# (RUNNER_EXT_TARGET); bid >= 1.045 x L0 with UL retrace >= 0.04 -> runner_extended_capture
# (RUNNER_EXT_ULREV). Guard fails -> sells at the touch as before.
# 8/19-10/5 replay vs SF4: Trade Profile 445 +$5,671 (DEV +$2,160, VAL +$3,511). Total 4,146
# +$5,861 (DEV +$2,350, VAL +$3,511). Flips 0. Losses worsened 0. Winners harmed 0. 15 changed.
# With R2X on: TP $91,611.31, Total -$156,184.91. Steps: R2X is PATH_V2 STEP 1 (old 1-24 = 2-25).
OPTION_PATH_V2_RUNNER_EXTENSION_ENABLED=true
OPTION_PATH_V2_RUNNER_EXTENSION_TARGET_MULT=1.25
OPTION_PATH_V2_RUNNER_EXTENSION_UL_RETRACE=0.04
OPTION_PATH_V2_RUNNER_EXTENSION_UL_MIN_MULT=1.045
OPTION_PATH_V2_RUNNER_EXTENSION_FLOOR_PRET=0.50
OPTION_PATH_V2_RUNNER_EXTENSION_MIN_TICKS=2
OPTION_PATH_V2_RUNNER_EXTENSION_JUMP_GUARD=0.5
OPTION_PATH_V2_RTC_RETRACE=0.20
OPTION_PATH_V2_RTC_MATERIAL_SEC=300
OPTION_PATH_V2_RTC_VEL=-0.0005
OPTION_PATH_V2_RTC_VEL_WINDOW=10
OPTION_PATH_V2_MATERIAL_HWM_PP=0.05
OPTION_PATH_V2_CAT_FLOOR=-0.80
OPTION_PATH_V2_CAT_MIN_AGE_SECONDS=60
# Shallow proof. First PATH_V2 check. Age 60s, running MFE from 10% up to but not including 20%, bid return at or under -30%.
OPTION_PATH_V2_SHALLOW_PROOF_STOP_ENABLED=true
OPTION_PATH_V2_SHALLOW_PROOF_MIN_AGE_SECONDS=60
OPTION_PATH_V2_SHALLOW_PROOF_MIN_MFE=0.10
OPTION_PATH_V2_SHALLOW_PROOF_MAX_MFE=0.20
OPTION_PATH_V2_SHALLOW_PROOF_PRET=-0.30
# STEP 2 | 20% Save (Nov 3 2026: +20% stall save, replaces the PVE3 first-touch latch).
# Latch at the first executable bid >= +20%; t20 = seconds open->touch. Sell a CALL
# with t20 >= 90s and peak < +50% once it has stalled >= 60s since touch and >= 60s
# since the peak, given back >= 15pp, still >= +11%, and new-high ticks / ticks since
# touch <= 0.05. Kill switch: OPTION_PATH_V2_20P_SAVE_ENABLED=false.
OPTION_PATH_V2_20P_SAVE_ENABLED=true
OPTION_PATH_V2_20P_SAVE_MIN_MFE=0.20
OPTION_PATH_V2_20P_SAVE_SIDES=call
OPTION_PATH_V2_20P_SAVE_MIN_T20_S=90
OPTION_PATH_V2_20P_SAVE_MAX_PEAK=0.50
OPTION_PATH_V2_20P_SAVE_MIN_SINCE_TOUCH_S=60
OPTION_PATH_V2_20P_SAVE_MIN_SEC_HWM=60
OPTION_PATH_V2_20P_SAVE_GIVEBACK=0.15
OPTION_PATH_V2_20P_SAVE_MIN_PRET=0.11
OPTION_PATH_V2_20P_SAVE_MAX_NEWHIGH_FRAC=0.05
OPTION_PATH_V2_20P_SAVE_SHADOW_ONLY=false
OPTION_PATH_V2_20P_SAVE_ULR_ENABLED=true
OPTION_PATH_V2_20P_SAVE_ULR_FRAC=0.90
OPTION_PATH_V2_20P_SAVE_ULR_MAX_ENTRY_VWAP_ATR=0.50
# Research snapshot only (po_mfe20_snapshot / capture_po_20p_first_touch). Not read by STEP 2.
# Evaluate-path capture hardcodes allow_sync_refresh=False so a 3s hub wait
# cannot serialize the 20–38 name book. Keep this false.
OPTION_PATH_V2_20P_SAVE_MAX_PVE3_AGE_SEC=75
OPTION_PATH_V2_20P_SAVE_SYNC_REFRESH=false
OPTION_PATH_V2_20P_SAVE_SYNC_TIMEOUT_SEC=3
OPTION_PATH_V2_STALE_MAX_SECONDS=10
OPTION_PATH_V2_AE_EXP_SPEED_MIN=0.0001
OPTION_PATH_V2_AE_SEC_HWM_MAX=120
OPTION_PATH_V2_AE_WARNING_ENABLED=true
OPTION_PATH_V2_AE_WARNING_WINDOW_SECONDS=90
OPTION_PATH_V2_AE_WARNING_STALL_SECONDS=45
OPTION_PATH_V2_AE_WARNING_MATERIAL_HWM_PP=0.02
OPTION_PATH_V2_AE_WARNING_MAX_START_RETURN=0.00
OPTION_PATH_V2_PREMIUM_TRAIL_ENABLED=false
OPTION_PATH_V2_PREMIUM_TRAIL_TRIGGER=1.00
OPTION_PATH_V2_PREMIUM_TRAIL_EXIT=0.30
OPTION_PATH_V2_PREMIUM_TRAIL_MIN_SEC_HWM=900
OPTION_PATH_V2_EARLY_PREM_TRAIL_ENABLED=false
OPTION_PATH_V2_EARLY_PREM_TRAIL_TRIGGER=1.75
OPTION_PATH_V2_EARLY_PREM_TRAIL_EXIT=0.05
OPTION_PATH_V2_EARLY_PREM_TRAIL_MIN_CURRENT=0.75
# Bounded high-MFE capture (Oct 17). Replay-selected 290-305% peak band after
# 10:45 PT; keeps the 350% runner regime and mandatory 12:30 MFE trail intact.
OPTION_PATH_V2_BOUNDED_MFE_CAPTURE_ENABLED=true
OPTION_PATH_V2_BOUNDED_MFE_CAPTURE_MIN_MFE=2.90
OPTION_PATH_V2_BOUNDED_MFE_CAPTURE_MAX_MFE=3.05
OPTION_PATH_V2_BOUNDED_MFE_CAPTURE_GIVEBACK=0.10
OPTION_PATH_V2_BOUNDED_MFE_CAPTURE_MIN_PRET=1.00
OPTION_PATH_V2_BOUNDED_MFE_CAPTURE_START_PT_HOUR=10.75
# Hybrid premium trail (Sep 28). Runs after catastrophic, 12:30 mfe_trail, and absorption.
# Stage 1 exits as premium_trail_>50%_25trail; Stage 2 exits as premium_trail_>30%_10trail.
# Off on the 9/10-9/25 Entry/Skip book: stage 2 clips hwm_rtc / mfe_trail / gb30 winners.
# CALL 110k / PUT 11k + C2 + R-PUT, theta off: hybrid net $6,175 vs $18,816 with the trail off.
OPTION_PATH_V2_HYBRID_PREMIUM_TRAIL_ENABLED=false
OPTION_PATH_V2_PREMIUM_TRAIL_GT50_ARM_MFE=0.50
OPTION_PATH_V2_PREMIUM_TRAIL_GT50_GIVEBACK=0.25
OPTION_PATH_V2_PREMIUM_TRAIL_GT50_MIN_AGE_SECONDS=60
OPTION_PATH_V2_PREMIUM_TRAIL_GT50_MIN_CURRENT_RETURN=0.20
