# =============================================================================
# Breakout0DTE.env — Breakout 0DTE path (full 0dte_list → first-hour H/L break)
# =============================================================================
# Sibling entry path (ORB SO / ORB1 Breakout / Trendline / Breakout).
# Universe: full 0dte_list (fair rotate). Levels: ORB #2 = ETrade session H/L at ~7:30
# (≈ 6:30–7:30). ORB #1 (6:30–6:45) stays on orb_strategy_manager for ORB1 Breakout.
# Broker for prices / levels / chains (Rev 00236). Session VWAP/vol/RSI for quality
# gates use the shared Jul 16 session-tech path (1m RTH → tech_source=session_1m_rth),
# same as Convex + Trendline — ETrade quotes have no native VWAP/volume_ratio.
# Enter CALL above high / PUT below low after material break + quality.
# No new entries after 12:30 PT. Skip ORB-filled / pending symbols (slot hygiene).
# See docs/0DTEORB2Breakout.md · docs/Data.md (session tech exception).
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Path toggle & scope
# -----------------------------------------------------------------------------
ENABLE_BREAKOUT_STRATEGY=true
# Open-count cap lives in Account0DTE.env BREAKOUT_0DTE_MAX_POSITIONS (7).
# Combined book: TOTAL_0DTE_MAX_POSITIONS (7).

# -----------------------------------------------------------------------------
# 2) Session / watch timing
# -----------------------------------------------------------------------------
# Clocks: Shared.env §5. ORB1 BO = DISCOVERY_ORB1_TL0_*. ORB2 BO = DISCOVERY_ORB2_TL_*.
# Soft entry window from first material break.
# CONFIRM past the window rearms WAIT_BREAK (no cooldown).
# READY this tick does not expire — fall through to QG. QG reject = 1h same-side CD.
BREAKOUT_SIMPLE_ENTRY_WINDOW_SEC=300
# Exec-ready TTL while READY_TO_EXECUTE waiting for slots. Default Shared.env
# 0DTE_EXEC_SIGNAL_EXPIRE_MINUTES=1. Uncomment to override this path only.
# BREAKOUT_EXEC_SIGNAL_EXPIRE_MINUTES=1
# Shared same-side 1h cooldown (ORB1 / BO / TL): terminal reject OR any filled exit.
# Opposite side stays open. Duration also used by path_exec_day_exclude / orb1_0dte_watch.
BREAKOUT_SIDE_REJECT_COOLDOWN_SECONDS=3600
# After a profitable fill+exit, clear day-executed lock and re-arm WAIT_BREAK.
# Both CALL/PUT stay gated until price prints inside ORB2; then either H or L
# break can qualify (e.g. SMCI 08:20 win → reclaim → later re-break).
# Exited side still sits on the 1h cooldown above. Red exits keep the day-executed lock.
# Discovery cadence/batch owned by Shared.env 0DTE_DISCOVERY_* (unified TL+BO scan).

# Legacy seed-band knobs (compat only — activate no longer Mid-filters on 15m ORB)
BREAKOUT_SEED_ABOVE_HIGH_MULT=1.001
BREAKOUT_SEED_BELOW_LOW_MULT=0.999

# -----------------------------------------------------------------------------
# 3) True breakout confirmation (not spike / retest)
# Shared ORB1 (ORB#1 levels) + ORB2 (ORB#2 levels) flat-box confirm.
# Aug 13: sole 0.08% floor (TL parity). Continuation / FT / chop deleted as admit.
# First print ≥0.08% beyond the box → READY → QG. Reclaim still invalidates.
# -----------------------------------------------------------------------------
# Confirm (desk % — loader ÷100). Alias: MIN_BREAK_DISTANCE_PCT.
BREAKOUT_BREAK_MIN=0.08
BREAKOUT_RECLAIM_INVALIDATES=true

# -----------------------------------------------------------------------------
# 4) Quality gates — hard admit first, observe/off last
# Next session collect: dir% >0.10 · vol >0.12 · VWAP observe |vwap%|≤1.00 stamp.
# Noted max-book remains BO-QG-A7∩A10-S (0DTEQualityGates §3.1 / §6).
# Sole admit = GATE_BO_* via quality_gate_stack. Do not re-enable BREAKOUT_*
# VWAP/vol scorer knives (duplicate bare put_above_vwap / volume_ratio_*).
# Discovery: Shared.env 0DTE_DISCOVERY_*. Data-gap quality miss → stay CONFIRM.
# Real quality / OTM / structural reject → 1h same-side CD + re-arm WAIT_BREAK.
# -----------------------------------------------------------------------------
# Quality Gate Stack — Layer C via stack; A/B cutover at quality decide
QUALITY_GATE_STACK_SHADOW=true
QUALITY_GATE_STACK_CUTOVER=true

# --- Hard admit: next-session collect (Aug 14 desk) ---
# Vol >0.12 (was A7 0.40). Noted max-book A7∩A10-S +$578 stays on the 42-fill replay.
GATE_BO_Vol_Ratio=hard
BREAKOUT_MIN_VOLUME_RATIO=0.012
BREAKOUT_VOLUME_MISSING_FAIL_CLOSED=true

GATE_BO_break_max=hard
QG_BREAK_MAX=2.50
QG_BO_BREAK_MAX=2.50
# Research wide collect (Eric 10/9/2026; QUALITY_GATE_ADMIT=wide_collect in Shared.env).
# Restored from the Sep 17 wide-collect config (git HEAD): dir% >0.10 hard, vol floor hard,
# break_max 2.50 hard, pc_oi off. Trade Profile runs in observe (stamps only).
GATE_BO_dir_pct=hard
GATE_BO_pc_oi=off
BREAKOUT_DIR_VOLUME_GATE_ENABLED=true
BREAKOUT_DIR_VOLUME_MIN_PCT=0.10

# Aug 26 collect: stamp only. Hard blocked EAT PUT (1.85% dump, BB 72.5) while
# also blocking energy CALL losers (XOM/CVX/FDX). Next deploy observes both sides.
GATE_BO_BB_mid=observe
QG_BO_BB_MID_CALL_MIN=50
QG_BO_BB_MID_PUT_MAX=50

# Score is extension-confidence ranker (observe). Not Convex 0.75 / Quality 55.
GATE_BO_score=observe

# Skip Signals (levels in Shared.env). CALL/PUT stay hard; Path SS off (more book).
# Absolute CALL/PUT: GATE_*_call_ss / put_ss. Strategy/side 0-MFE: GATE_*_path_ss.
# Eric 10/9 17:16 PT: CALL/PUT Skip Signals ON (hard) on wide collect. Path SS stays off (Sep 4 wide collect).
GATE_BO_call_ss=hard
GATE_BO_put_ss=hard
GATE_BO_path_ss=off

# -----------------------------------------------------------------------------
# 4b) Contract OTM + cheap-lotto (hard)
# OTM ≤3.5% (winners ≤2.0%; still blocks WULF 3.6% chase).
# -----------------------------------------------------------------------------
BREAKOUT_OTM_GATE_ENABLED=true
BREAKOUT_PREFER_MAX_OTM_PCT=0.035
BREAKOUT_RESEARCH_MAX_OTM_PCT=0.035
BREAKOUT_CHEAP_LOTTO_GUARD_ENABLED=true
BREAKOUT_CHEAP_LOTTO_MAX_PREMIUM=0.15
BREAKOUT_CHEAP_LOTTO_MAX_QTY=8
BREAKOUT_CHEAP_LOTTO_NEAR_ATM_OTM_PCT=0.05
BREAKOUT_CHEAP_LOTTO_MODE=reject
BREAKOUT_CHEAP_LOTTO_DOWNSIZE_TO=1

# -----------------------------------------------------------------------------
# 4c) Observe / off — stamp only; do not hard-block
# ATR / IV / soft-break / extra |δ|≤0.36 removed Aug 17 (killed held-beyond names; duplicated contract δ).
# Contract |δ| is shared 0.18–0.42 (0DTE_ENTRY_DELTA_*).
# -----------------------------------------------------------------------------
GATE_BO_VWAP=observe
BREAKOUT_REQUIRE_VWAP_ALIGNMENT=false
# Observe only. Fraction: 0.01 = |vwap%| ≤ 1.00 stamp (hub distance is percent, e.g. 2.09 = 2.09%).
# Do not set 1.0 here — BO treats ≤1.0 as a fraction (1.0 → 100%).
BREAKOUT_VWAP_EXTENSION_REJECT_PCT=0.01
BREAKOUT_VWAP_MISSING_FAIL_OPEN=false

GATE_BO_RSI_band=off
BREAKOUT_CALL_MIN_RSI=0
BREAKOUT_PUT_MAX_RSI=100

BREAKOUT_MACD_HOLD_GATE_ENABLED=false
BREAKOUT_VOLUME_RATIO_GATE_ENABLED=false

GATE_BO_RSI_stamp=observe
GATE_BO_MACD=observe
GATE_BO_BB_upper=observe
GATE_BO_BB_middle=observe
GATE_BO_BB_lower=observe
GATE_BO_BB_width=observe
GATE_BO_BB_pctB=observe
GATE_BO_call_vol=observe
GATE_BO_put_vol=observe

# -----------------------------------------------------------------------------
# 5) Profit Optimizer (optional)
# -----------------------------------------------------------------------------
ENABLE_BREAKOUT_PROFIT_OPTIMIZER=true
