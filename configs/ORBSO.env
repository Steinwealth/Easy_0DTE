# =============================================================================
# ORBSO.env — ORB Standard Order (ETF) path
# =============================================================================
# Path section groups (same seven titles as ORB0DTE.env & Trendline0DTE.env):
#  1 Path toggle & scope
#  2 ORB & session timing
#  3 Eligibility, scoring & filters
#  4 Position sizing & capital
#  5 Instruments, spreads & liquidity
#  6 Execution gating & runtime checks
#  7 Profit capture & monitoring (ETF EOD window; live stealth → Risk.env STEALTH_*)
# See configs/README.md for the cross-path map.
#
# Loaded by ConfigLoader after Shared.env. Values here override Shared only if
# the same key name appears in both (avoid duplicate keys across files).
#
# OTHER LAYERS (not duplicated here): Data.env, Shared.env, Risk.env, Alerts.env.
# Advanced/quantum: modules/strategy_mode_presets.py (after these seven files).
# =============================================================================

# =============================================================================
# SHARED — defined in configs/Shared.env (reference only; do not duplicate keys)
# =============================================================================
# -- 1) Signal routing & generator --
#     PRIMARY_SIGNAL_GENERATOR
# -- 2) Options data policy --
#     REQUIRE_LIVE_OPTION_DATA
# -- 3) Position sizing (combined options book) --
#     MAX_TOTAL_OPTION_POSITIONS
# -- 4) ORB boundaries & index capture --
#     ORB_BREAK_TOLERANCE
#     ORB_RTH_INTRADAY_SYMBOLS
# -- 5) Execution gating & portfolio hygiene --
#     ENABLE_SIGNAL_LEVEL_RED_DAY_FILTER
#     ENABLE_EXECUTION_FEATURE_SNAPSHOT
#     PREVENT_DUPLICATE_TRADES
# =============================================================================

# =============================================================================
# PATH — ORB Standard Order (ETF)
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Path toggle & scope
# -----------------------------------------------------------------------------
# Aug 7 remodel: ORB SO paused — ORB1 Breakout uses ORB1 rotating discovery 07:00–07:10.
ENABLE_ORB_STRATEGY=false
# Operator preset — continuation / exhaustion / extension / winner ranking bundle (see modules/config_profiles.py).
SO_PROFILE=balanced
# Pause validation candle (7:00 open / 7:15 prefetch) — ORB1 Breakout no longer gated on it.
ENABLE_VALIDATION_CANDLE=false
# Pause 7:15–7:30 signal collection batch — replaced by ORB1 watch discovery.
ENABLE_ORB_SIGNAL_COLLECTION=false

# -----------------------------------------------------------------------------
# 2) ORB & session timing (PT)
# -----------------------------------------------------------------------------
# ORB#1 capture + 0DTE discovery clocks: Shared.env §5 (ORB_WINDOW_* · DISCOVERY_*).
# Legacy SO signal collection window (paused when ENABLE_ORB_SIGNAL_COLLECTION=false).
SO_ENTRY_TIME=07:15
SO_CUTOFF_TIME=07:30
# Batch ETF execution time (defaults to SO_CUTOFF_TIME if unset or empty).
SO_EXECUTION_TIME=07:30
# Validation candle for volume color + close vs ORB (paused when ENABLE_VALIDATION_CANDLE=false).
SO_VALIDATION_CANDLE_START=07:00
SO_VALIDATION_CANDLE_END=07:15
# Post-ORB chop filter window (sideways engulfing both ORB edges → trading disabled for symbol).
SO_POST_ORB_CANDLE_START=06:45
SO_POST_ORB_CANDLE_END=07:00
# ORB1 Breakout discovery exec priority window (aligned to 07:00–07:10 watch mode).
ORB_CRITICAL_WINDOW_START_PT=6:59:45
ORB_CRITICAL_WINDOW_END_PT=7:10:00
ORB_CRITICAL_WINDOW_MAX_CHAIN_CONTRACTS=24

# -----------------------------------------------------------------------------
# 3) Eligibility, scoring & filters
# -----------------------------------------------------------------------------
# Expert overrides (normally supplied by SO_PROFILE); explicit lines here win over profile defaults.
# Distance beyond ORB high/low as a fraction of level (0.001 = 0.1%) — bullish SO branch.
SO_BULLISH_THRESHOLD=0.001
# Reserved symmetry with bearish/0DTE docs (bearish SO uses touch-at/below low + candle rules).
SO_INVERSE_THRESHOLD=0.001
# Initial take-profit distance for signal objects (%); long TP = price×(1+pct/100), short TP = price×(1−pct/100).
SO_TARGET_GAIN_PCT=3.0
# 7:30 fresh-quote filter: SO ETF LONG + 0DTE CALL — keep if price >= orb_high * multiplier (default 1.000).
CALL_RECHECK_BREAKOUT_MULTIPLIER=1.000
SO_ADAPTIVE_EXPENSE_THRESHOLD_MULTIPLIER=3.0
SO_ADAPTIVE_EXPENSE_RATIO_LIMIT=0.45
SO_ADAPTIVE_PROGRESSIVE_TARGETS=15,14,12,10,8
# SO ranking refinement (Rev 00348): SO_CONTINUATION_MOMENTUM_WEIGHT = **base-score share**
# for continuation quality (momentum + MACD), not a tiny additive bump.
SO_CONTINUATION_MOMENTUM_WEIGHT=0.36
SO_EXHAUSTION_PENALTY_WEIGHT=0.08
SO_MAX_EXTENSION_SOFT_PENALTY=0.12
SO_ORB_RANGE_SOFT_PENALTY=0.05
SO_MOMENTUM_DECELERATION_PENALTY=0.06
# Rev 00349 — session evidence (May 11/14/18/20): VWAP extension + confidence cap
SO_ENTRY_BELOW_VWAP_STACK_PENALTY=0.14
SO_ENTRY_BELOW_VWAP_PCT=-8.0
SO_ENTRY_VWAP_CHASE_PENALTY=0.18
SO_ENTRY_VWAP_CHASE_PCT=35.0
SO_ENTRY_MAX_VWAP_EXTENSION_PCT=50.0
SO_ENTRY_WEAK_CONTINUATION_PENALTY=0.12
# Winner-profile runtime knobs (defined here to avoid silent fallback defaults)
SO_WINNER_PROFILE_FILTER_ENABLED=true
SO_WINNER_MIN_VOLUME_RATIO=0.75
SO_WINNER_HARD_MIN_VOLUME_RATIO=0.55
SO_WINNER_MIN_CONFIDENCE=0.80
SO_WINNER_MAX_RSI_NON_BULL=66.0
SO_WINNER_MIN_VWAP_DISTANCE=-0.35
SO_WINNER_MIN_KEEP_COUNT=8
# Skip ORB SO execution when priority_score <= floor (ranking unchanged; Jun 1: MSTR PS=0 loser).
SO_SKIP_ZERO_PRIORITY_SCORE=true
SO_MIN_PRIORITY_SCORE_FOR_EXECUTION=0.001
# Rev 00353 — continuation-shaped signal confidence (replaces 0.7+10×break monotonic formula)
SO_CONFIDENCE_CONTINUATION_SHAPE_ENABLED=true
SO_CONFIDENCE_BASE=0.72
SO_CONFIDENCE_BREAK_PEAK_PCT=2.5
SO_CONFIDENCE_BREAK_PEAK_BOOST=0.10
SO_CONFIDENCE_CHASE_START_PCT=4.0
SO_CONFIDENCE_TIGHT_ORB_PCT=4.0
SO_CONFIDENCE_WIDE_ORB_PCT=5.5
SO_CONFIDENCE_MAX=0.95
SO_CONFIDENCE_MIN=0.52
# Rev 00352 — May 22 desk geometry (Tier A tight ORB; Tier B wide/chase; inverse sleeve)
SO_TIER_A_MAX_ORB_RANGE_PCT=4.0
SO_TIER_A_MAX_BREAK_PCT=4.0
SO_TIER_B_MIN_ORB_RANGE_PCT=5.5
SO_TIER_B_CHASE_BREAK_PCT=4.0
SO_TIER_A_GEOMETRY_BOOST=0.06
SO_TIER_B_GEOMETRY_PENALTY=0.10
SO_HIGH_CONF_WIDE_ORB_MULT=0.80
SO_HIGH_CONF_CHASE_BREAK_MULT=0.78
SO_INVERSE_BREAK_CHASE_PCT=3.0
SO_INVERSE_SLEEVE_PENALTY=0.12
SO_INVERSE_SYMBOL_SUBSTRINGS=MSTZ,SQQQ,SPXU,SPXS,SDS,QID,SOXS,UVXY
SO_ADAPTIVE_PROTECT_TIER_A_GEOMETRY=true
SO_ADAPTIVE_TIER_A_PROTECT_MAX=4

# -----------------------------------------------------------------------------
# 4) Position sizing & capital — ORB SO ETF sizing retired
# -----------------------------------------------------------------------------
# Combined 0DTE book: Account0DTE.env TOTAL_0DTE_MAX_POSITIONS / 0DTE_SLOT_COUNT.
# Do not set MAX_CONCURRENT_TRADES / SO_ETF_* size keys — SO ETF is off.
# Canonical 0DTE seed: 0DTE_DEMO_STARTING_BALANCE in Account0DTE.env.
CASH_RESERVE_PCT=10

# -----------------------------------------------------------------------------
# 5) Instruments, spreads & liquidity
# -----------------------------------------------------------------------------
# (n/a on ETF SO batch path — options-only; see ORB0DTE.env / Trendline0DTE.env.)

# -----------------------------------------------------------------------------
# 6) Execution gating & runtime checks
# -----------------------------------------------------------------------------
# Unified 7:30 portfolio protection (modules/portfolio_protection.py).
# Red Day patterns 1–3 + Protection Day (below-VWAP breadth + weak median volume).
# Aug 7: PAUSED — Signal Collection off; ORB1 Breakout uses ORB#1 watch 07:00–07:10.
# PP/Red Day pool was Signal Collection ranked rows @ 7:30 — not available this session model.
# Re-enable with SC (ENABLE_ORB_SIGNAL_COLLECTION=true) + ORB_0DTE_DISCOVERY_MODE=batch.
ENABLE_PORTFOLIO_PROTECTION=false
ENABLE_PORTFOLIO_PROTECTION_DAY=false
ENABLE_RED_DAY_TIER_GATE=false
PORTFOLIO_PROTECTION_VWAP_BELOW_PCT=50
PORTFOLIO_PROTECTION_MEDIAN_VOLUME_MAX=0.45
# Split/chop tape (Rev 00375): skip when median pool VWAP distance < 2% and median vol weak
ENABLE_PORTFOLIO_PROTECTION_SPLIT_TAPE=false
PORTFOLIO_PROTECTION_MEDIAN_VWAP_MIN_PCT=2.0
PORTFOLIO_PROTECTION_VWAP_COVERAGE_MIN_PCT=80
PORTFOLIO_PROTECTION_VOLUME_COVERAGE_MIN_PCT=80
# Portfolio protection (7:30 gate): section 6 above · slip → Risk.env · alerts → Alerts.env
# PP blocks SO + arms tier-policy as designed (FINAL/LIVE parity). PO collects skip cohort @ 7:30 via signal_collection_730.
# RESEARCH observe-only: trigger fires, tags session, does not block SO or 0DTE (pc_oi Convex handles skew).
PORTFOLIO_PROTECTION_BLOCK_EXECUTION=false

# -----------------------------------------------------------------------------
# 7) Profit capture & monitoring (ORB SO ETF)
# -----------------------------------------------------------------------------
# Live profit capture (BE, trail, rapid exit): configs/Risk.env STEALTH_* → prime_stealth_trailing_tp.py
# ETF SO book flatten: Shared.env §5 EOD_FLATTEN_* (aliases SO_ETF_EOD_CLOSE_* still read).
# Cloud Scheduler may still drive separate EOD reports (see docs/Alerts.md).
# Portfolio protection (7:30 gate): section 6 above · slip → Risk.env · alerts → Alerts.env
