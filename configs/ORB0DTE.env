# =============================================================================
# ORB0DTE.env — ORB1 Breakout options path
# =============================================================================
# Operator name: ORB1 Breakout.
# Legacy filename/key prefixes (`ORB0DTE`, `ORB_0DTE_*`, `orb_0dte`) are retained
# for runtime compatibility until a separate key migration is planned and tested.
# Path section groups (same seven titles as ORBSO.env & Trendline0DTE.env):
#  1 Path toggle & scope
#  2 ORB & session timing
#  3 Eligibility, scoring & filters
#  4 Position sizing & capital
#  5 Instruments, spreads & liquidity
#  6 Execution gating & runtime checks
#  7 Profit capture & monitoring (path monitors; live stealth → Shared.env OPTION_STEALTH_*)
# See configs/README.md for the cross-path map.
#
# Loaded after ORBSO.env. Chain / executor / Convex / priority keys use 0DTE_*.
# NEUTRAL validation candle: 0DTE_ORB_TREAT_* (ORB manager: SO + 0DTE).
# E*TRADE 0DTE account id: typically Data.env (ETRADE_0DTE_ACCOUNT_ID); optional
# overrides: 0DTE_ETRADE_ACCOUNT_ID / 0DTE_ETRADE_SECRET_NAME / 0DTE_BROKER_TYPE (see broker_config_manager).
# =============================================================================

# =============================================================================
# SHARED — defined in configs/Shared.env (reference only; do not duplicate keys)
# =============================================================================
# -- 1) Signal routing & generator --
#     PRIMARY_SIGNAL_GENERATOR
# -- 2) Options data policy --
#     REQUIRE_LIVE_OPTION_DATA
# -- 3) Position sizing (combined options book) --
#     MAX_TOTAL_OPTION_POSITIONS
# -- 4) ORB boundaries & index capture --
#     ORB_BREAK_TOLERANCE
#     ORB_RTH_INTRADAY_SYMBOLS
# -- 5) Execution gating & portfolio hygiene --
#     ENABLE_SIGNAL_LEVEL_RED_DAY_FILTER
#     ENABLE_EXECUTION_FEATURE_SNAPSHOT
#     PREVENT_DUPLICATE_TRADES
# =============================================================================

# =============================================================================
# PATH — ORB1 Breakout options
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Path toggle & scope
# -----------------------------------------------------------------------------
ENABLE_0DTE_STRATEGY=true
# Operator preset — bundles chain-health, selector failover, convex, overextension, liquidity, priority (see modules/config_profiles.py).
ORB_0DTE_EXECUTION_PROFILE=balanced_open
# Demo desk: simulated ledger only — broker order submit is LIVE-only (MODE=live).
0DTE_DEMO_ALLOW_DEGRADED_CHAIN=false

# -----------------------------------------------------------------------------
# 2) ORB & session timing
# -----------------------------------------------------------------------------
# NEUTRAL validation candle (open≈close); legacy 0DTE_VIX_* if unset
0DTE_ORB_TREAT_NEUTRAL_AS_GREEN=true
0DTE_ORB_TREAT_NEUTRAL_AS_RED=true
# Watch = BO-style rotating discovery on ORB#1 (clocks in Shared.env §5).
# Activate only after ORB1 capture → Yahoo 1m → TL0 inject.
# batch = legacy 7:15–7:30 signal collection + Step 5 one-shot (paused locally).
ORB_0DTE_DISCOVERY_MODE=watch
# DISCOVERY_ORB1_TL0_START_PT / DISCOVERY_ORB1_TL0_END_PT → Shared.env §5
# Hard stop with TL0: expire_orb1_discovery_after_cutoff at DISCOVERY_ORB1_TL0_END_PT.
# Soft entry window from first material ORB1 break (seconds); expire CONFIRM→re-arm.
ORB_0DTE_SIMPLE_ENTRY_WINDOW_SEC=300
# Opening selector window = discovery start → no-new-entries.
# ORB1 Breakout watch mode: no new entries after 07:25. Skipped/rejected signals do not
# get a later grace window.

# -----------------------------------------------------------------------------
# 3) Eligibility, scoring & filters
# -----------------------------------------------------------------------------
# Convex / chop / chain-health / priority / partial tiers / overextension / latency:
# defaults live in modules/orb0dte_execution_defaults.py and ORB_0DTE_EXECUTION_PROFILE.
# Add KEY= lines here only for deliberate path overrides (they win over profile defaults).
# Convex pc_oi filter: chain OI skew + ORB range min/max + v2.5 symmetric side gates
0DTE_CONVEX_ORB_RANGE_MIN=0.25
0DTE_CONVEX_V25_SYMMETRIC_ENABLED=true
# Quality Gate Stack — shadow reports + cutover ON (singular admit)
QUALITY_GATE_STACK_SHADOW=true
QUALITY_GATE_STACK_CUTOVER=true
# Research wide collect (Eric 10/9/2026; QUALITY_GATE_ADMIT=wide_collect in Shared.env).
# Restored from the Sep 17 wide-collect config (git HEAD): dir% >0.10 hard, vol floor hard,
# break_max 2.50 hard, pc_oi off. Trade Profile runs in observe (stamps only).
GATE_ORB_dir_pct=hard
GATE_ORB_pc_oi=off
0DTE_DIR_VOLUME_GATE_ENABLED=true
0DTE_DIR_VOLUME_MIN_PCT=0.10
# Trade Profile is the admit. Directional percent and open interest are profile keys.
# Cloud needs `deploy now`.
# Skip Signals (levels in Shared.env). CALL/PUT stay hard; Path SS off (more book).
# Absolute CALL/PUT: GATE_*_call_ss / put_ss. Strategy/side 0-MFE: GATE_*_path_ss.
# Eric 10/9 17:16 PT: CALL/PUT Skip Signals ON (hard) on wide collect. Path SS stays off (Sep 4 wide collect).
GATE_ORB_call_ss=hard
GATE_ORB_put_ss=hard
GATE_ORB_path_ss=off
# Research stamps (observe until levels locked from PO desks)
GATE_ORB_RSI_stamp=observe
GATE_ORB_MACD=observe
GATE_ORB_BB_upper=observe
GATE_ORB_BB_middle=observe
GATE_ORB_BB_lower=observe
GATE_ORB_BB_width=observe
GATE_ORB_BB_pctB=observe
GATE_ORB_call_vol=observe
GATE_ORB_put_vol=observe
GATE_ORB_VWAP=observe
GATE_ORB_RSI=observe
# Percent points (1.0 = 1%). Observe: stamp ext_>1.0, do not hard-block.
ORB_VWAP_EXTENSION_REJECT_PCT=1.0
QG_ORB_RSI_CALL_MAX=60
QG_ORB_RSI_PUT_MIN=40
GATE_ORB_Vol_Ratio=hard
# First-hour ORB1: RSI/vol often absent until ≥2 usable 1m bars. Missing skips
# (do not 1h-block). Measured ratio still hard vs continuation floor.
ORB_VOLUME_MISSING_FAIL_CLOSED=false
GATE_ORB_score=observe
GATE_ORB_break_max=hard
# Shared ORB1/ORB2 break-distance (percent points). Box width 0.25–8.0% is not distance.

# Session tech master switch (ORB / Trendline / Breakout) — Jul 16 · unified Jul 29
# Module: modules/session_tech_indicators.py · TTL refresh: 0DTE_SESSION_TECH_MAX_AGE_SEC=90
0DTE_CONVEX_SESSION_TECH=true
# 0DTE_SESSION_TECH_MAX_AGE_SEC=90
0DTE_CONVEX_VWAP_EXTENSION_REJECT_PCT=15.0
# E16: disagree eps observe (deep soft-neg OK) + mild soft-neg deadband quality ON
# Quality band ±0.50 independent of eps — blocks Aug 5 SLV/DAL/ETN; keeps Aug 6 ASML/MU/SNDK
0DTE_CONVEX_MACD_DISAGREE_EPS=99
0DTE_QG_MACD_DEADBAND_QUALITY_ENABLED=true
0DTE_QG_MACD_DEADBAND_ORB_MAX_PCT=1.0
0DTE_QG_MACD_DEADBAND_MACD_ABS_MIN=0.60
0DTE_QG_MACD_DEADBAND_VOL_MAX=0.20
0DTE_QG_MACD_DEADBAND_NOISE_BAND=0.50
# E15: widen ORB max 5.5→8.0 (preserves MELI/HOOD + Aug KTOS-class headroom)
0DTE_CONVEX_ORB_RANGE_MAX_PCT=8.0
# E14 admit OFF — conflicts with Jun 26 E11 below-VWAP CALL winners (telemetry only)
0DTE_SHALLOW_E14_ENABLED=false
0DTE_SHALLOW_CALL_MACD_MIN=2.0
0DTE_SHALLOW_PUT_MACD_MAX=-2.0
# Matrix Layer 5 — chase / regime (Call/Put agnostic + cited exceptions)
0DTE_CONVEX_CHASE_SKIP_ENABLED=true
0DTE_CONVEX_E10_ENABLED=true
0DTE_CONVEX_E11_ENABLED=true
0DTE_CONVEX_E7_ENABLED=true
0DTE_CONVEX_E7_INDEX_SYMBOLS=SPY,QQQ,IWM,RUT,MAGS
# Trend regime (symmetric CALL/PUT): orb_range >= ORB_RANGE_MIN * mult => trend. 1.0 = min-width ORB counts.
0DTE_CONVEX_REGIME_ORB_MULT=1.0
# Canonical ★ stack (RESEARCH + LIVE): Convex E16 + Gate 3c PS>=0.30 + PS v2.1
# PS v2.1 — ORB1 Breakout early-continuation ranker (replaces SO-mirror for options ranking)
0DTE_PRIORITY_USE_PS_V2=true
# Fallback: mirror ORB SO CALL / reversed SO PUT when PS_V2=false
0DTE_PRIORITY_USE_SO_RANK=true
# Gate 3c — E14 admit OFF (Jun 26 E11 conflict); PS floor remains
0DTE_SKIP_ZERO_PRIORITY_SCORE=true
# Aug 6 PS v2.1 desk: 0.30 skips SBUX/RNG/ASTS/KTOS/RKLB/CSCO junk; keeps lowest wins (≥0.348)
0DTE_MIN_PRIORITY_SCORE_FOR_EXECUTION=0.30
# Strategy route — ORB1 Breakout single-leg primary (0DTE_ORB_LOTTO_FIRST legacy alias)
0DTE_ORB_LOTTO_FIRST=true
0DTE_ORB_SPREAD_PRIMARY_ENABLED=false
0DTE_ORB_SPREAD_FALLBACK_ENABLED=false
# Legacy spread SO-tier debit override (inactive unless spread primary re-enabled)
0DTE_STRATEGY_SO_DEBIT_SPREAD_MIN_PS=0.17
# Single-leg opening premium relax (symmetric CALL/PUT)
0DTE_SINGLE_LEG_OPENING_PREMIUM_RELAX=true
0DTE_SINGLE_LEG_OPENING_MOMENTUM_MIN=50.0
0DTE_SINGLE_LEG_OPENING_ORB_RANGE_MIN=0.35
# Delta viability (lowest viable delta step-up) — sync to Cloud Run (Jun 5 P0)
0DTE_DELTA_VIABILITY_STEP_UP_MIN=0.15
0DTE_DELTA_VIABILITY_STEP_UP_MAX=0.35
0DTE_DELTA_VIABILITY_BREAKEVEN_CUSHION=1.20
0DTE_DELTA_VIABILITY_ORB_RANGE_FRACTION=0.65
0DTE_DELTA_VIABILITY_MIN_EXPECTED_MOVE_PCT=0.25
0DTE_DELTA_VIABILITY_MOONSHOT_MOMENTUM=85.0
0DTE_DELTA_VIABILITY_MOONSHOT_ORB_RANGE_PCT=1.50
# Legacy Rev 00352 weights (only when 0DTE_PRIORITY_USE_SO_RANK=false; code defaults apply)
0DTE_PRIORITY_SO_TOP_TIER=0.98
0DTE_PRIORITY_SO_TOP_TIER_MULT=1.10
0DTE_PRIORITY_BOOST_CONTINUATION_SWEET=1.14
0DTE_PRIORITY_BOOST_DESK_CONTINUATION=1.08
0DTE_PRIORITY_PEN_ULTRA_TIGHT_BREAK=0.88
# Rev 00352 — Tier-A geometry Convex relief + priority (May 22; does not lower global PUT min)
0DTE_CONVEX_TIER_A_CALL_EXCEPTION=true
0DTE_CONVEX_TIER_A_SO_PRIORITY_FLOOR=0.50
0DTE_PRIORITY_TIER_A_GEOMETRY_MULT=1.12
0DTE_PRIORITY_TIER_B_GEOMETRY_MULT=0.88
0DTE_PRIORITY_CHASE_CONF_BREAK_PCT=4.0
0DTE_PRIORITY_HIGH_CONF_CHASE_MULT=0.85

# -----------------------------------------------------------------------------
# 4) Position sizing & capital (path funnel — account caps in Account0DTE.env)
# -----------------------------------------------------------------------------
# ORB1 rolling open-count = Account0DTE.env ORB_0DTE_MAX_POSITIONS.
# Legacy 7:30 top-N keys (ORB_0DTE_PRIORITY_RANK_FINAL_BATCH_MAX and aliases) are
# unused — discovery mode=watch; rolling ORB1/ORB2 do not use a 7:30 batch funnel.
0DTE_MAX_EXECUTION_CANDIDATES=50
# Capital % / per-position caps: Account0DTE.env (0DTE_TRADING_CAPITAL_PCT, 0DTE_MAX_POSITION_SIZE_PCT)
# Equal 1/N slots by default (same allocator as Trendline). Ranking still picks top-K.
0DTE_RANK_SIZING_ENABLED=false
0DTE_EXECUTOR_MAX_POSITION_SIZE_PCT=35
# Optional rank overlays when 0DTE_RANK_SIZING_ENABLED=true
0DTE_RANK_MULT_1=3.0
0DTE_RANK_MULT_2=2.5
0DTE_RANK_MULT_3=2.0
0DTE_RANK_MULT_4_5=1.71
0DTE_RANK_MULT_6_10=1.5
0DTE_RANK_MULT_11_15=1.2
0DTE_RANK_MULT_16_PLUS=1.0

# -----------------------------------------------------------------------------
# 5) Instruments, spreads & liquidity
# -----------------------------------------------------------------------------
# Shared entry policy lives in Shared.env:
# 0DTE_MAX_ENTRY_PREMIUM, 0DTE_MIN_ENTRY_PREMIUM, 0DTE_ENTRY_DELTA_*,
# 0DTE_ENTRY_MIN_VOLUME, 0DTE_ENTRY_MIN_OPEN_INTEREST, LIVE_MIN_ASK/BID_SIZE.
0DTE_LIVE_MAX_QUOTE_AGE_SECONDS=10
0DTE_DEBIT_SPREAD_WIDTH_OPTIONS=1.0,2.0,3.0,5.0
0DTE_LOTTO_SLEEVE_ENABLED=false
# Liquidity aliases must match canonical ENTRY floors (volume=50, open_interest=100). No soft 30/75 chain floor.
0DTE_OPTIONS_MIN_OPEN_INTEREST=100
# Canonical chain-manager spread cap (% points, e.g. 8.0 = 8%). Legacy alias: 0DTE_OPTIONS_MAX_BID_ASK_SPREAD_PCT.
0DTE_MAX_BID_ASK_SPREAD_PCT=8.0
0DTE_OPTIONS_MIN_VOLUME=50
0DTE_MIN_OPEN_INTEREST=100
0DTE_MIN_VOLUME=50
# Single-leg directional selector floors (runtime active)
0DTE_SINGLE_LEG_MIN_OPEN_INTEREST=200
0DTE_SINGLE_LEG_MIN_VOLUME=75
0DTE_SINGLE_LEG_OPEN_WINDOW_MINUTES=5
0DTE_SINGLE_LEG_OPEN_WINDOW_OI_MULT=0.50
0DTE_SINGLE_LEG_OPEN_WINDOW_VOLUME_MULT=0.50
# Opening execution window only: align single-leg OI with hard gate (Jun 2 2026)
0DTE_SINGLE_LEG_OPEN_WINDOW_MIN_OI=100
# Shared entry delta band lives in Shared.env.
0DTE_ENTRY_PREFER_LOWEST_DELTA=false
# Shared Layer D OTM gate (Jul 28 book lock — ≤5.5% maximizes 18-trade enter set)
0DTE_OTM_GATE_ENABLED=true
0DTE_ENTRY_OTM_PCT_PREFER=0.055
0DTE_ENTRY_OTM_PCT_MAX=0.055
# Sub-$25 underlyings: skip when no in-band liquid contract (no high-delta ATM fallback)
0DTE_PENNY_NAME_SPOT_MAX=25
# Directional single-leg selector spread remains ORB-specific; premium cap/floor is shared.
# Directional single-leg max bid/ask % (base); mega-cap unchanged; high-momentum can widen via 0DTE_SINGLE_LEG_MOMENTUM_MAX_SPREAD_PCT in code path
0DTE_SINGLE_LEG_DIRECTIONAL_MAX_SPREAD_PCT=8.0
# Expiry & long-leg premium banding (options_chain_manager strike selection)
# Same-day 0DTE when listed; Mon–Thu resolve optionexpiredate first (skip 10031).
# After a same-day miss, later scans skip that day and fetch the memoized weekly.
0DTE_NEAREST_EXPIRY_MAX_DAYS=10
0DTE_EXPIREDATE_RESOLVE_FIRST=weekday
# Session memos (code defaults; override only if needed)
# Same-day empty: Mon–Wed session (4h), Thu–Fri 45m unless this key is set.
# 0DTE_EMPTY_SAME_DAY_TTL_SEC=2700
# 0DTE_EMPTY_EXPIRY_TTL_SEC=14400
# 0DTE_NEAREST_EXPIRY_MEMO_TTL_SEC=14400
# 0DTE_EXPIRE_DATES_TTL_SEC=14400
# Spread long-leg premium (inactive while 0DTE_ORB_LOTTO_FIRST=true — spread experiments only)
# 0DTE_DEBIT_LONG_PREMIUM_MIN=0.15
# 0DTE_DEBIT_LONG_PREMIUM_MAX_STRICT=0.60
# 0DTE_DEBIT_LONG_PREMIUM_MAX_SOFT=1.20
# 0DTE_DEBIT_LONG_PREMIUM_MAX_RESCUE=2.50
0DTE_DEBIT_LONG_OTM_MIN=1
0DTE_DEBIT_LONG_OTM_MAX=5
0DTE_DELTA_ORB_PCT_HIGH=0.5
0DTE_DELTA_ORB_PCT_MED=0.35
0DTE_MOMENTUM_ORB_BOUNDS=0.5,0.35,0.25,0.15
0DTE_MOMENTUM_ORB_POINTS=20,15,10,5,0
0DTE_MOMENTUM_VOLUME_BOUNDS=3,2,1.5,1.2
0DTE_MOMENTUM_VOLUME_POINTS=20,15,10,5,0
0DTE_MOMENTUM_CONF_BOUNDS=0.9,0.75,0.6,0.45
0DTE_MOMENTUM_CONF_POINTS=20,15,10,5,0
0DTE_MOMENTUM_VWAP_LONG_BOUNDS=1.0,0.5,0.0
0DTE_MOMENTUM_VWAP_LONG_POINTS=20,15,10,5
0DTE_MOMENTUM_VWAP_SHORT_BOUNDS=-1.0,-0.5,0.0
0DTE_MOMENTUM_VWAP_SHORT_POINTS=20,15,10,5
0DTE_MOMENTUM_ALIGN_PERFECT=20
0DTE_MOMENTUM_ALIGN_PARTIAL=10
0DTE_MOMENTUM_ALIGN_NONE=0
0DTE_MOMENTUM_ALIGN_NEUTRAL_NO_MARKETDATA=10

# Selector execution calibration (momentum / hard-gate window / thin chains — May 13)
0DTE_MOMENTUM_SKIP_ATM_SPREAD_TIERS_MIN=70
# Opening hard-gate ET window only: 8.0 * 1.25 = 10.0% effective cap (Jun 2 2026)
0DTE_HARD_GATE_EXEC_SPREAD_RELAX_MULT=1.25
0DTE_DEBIT_SHORT_LEG_STEP_MULT=6.0
0DTE_DEBIT_SELECTOR_HIGH_MOMENTUM_MIN=68
0DTE_SINGLE_LEG_MOMENTUM_RELAX_MIN=72
0DTE_SINGLE_LEG_MOMENTUM_FLOOR_OI=100
0DTE_SINGLE_LEG_MOMENTUM_FLOOR_VOL=50
0DTE_SINGLE_LEG_MOMENTUM_MAX_SPREAD_PCT=10.0
0DTE_LIQUIDITY_RELAX_EXTRA_SYMBOLS=RGTI,QBTS,IREN,PLTR

# Delta & spread width ladder — bucket (SPX|QQQ|SPY|OTHER) × tier (HIGH|MED|LOW); defaults match prime_0dte_strategy_manager
0DTE_DELTA_SPX_HIGH_DELTA=0.30
0DTE_DELTA_SPX_HIGH_WIDTH=10.0
0DTE_DELTA_SPX_MED_DELTA=0.25
0DTE_DELTA_SPX_MED_WIDTH=5.0
0DTE_DELTA_SPX_LOW_DELTA=0.15
0DTE_DELTA_SPX_LOW_WIDTH=5.0
0DTE_DELTA_QQQ_HIGH_DELTA=0.30
0DTE_DELTA_QQQ_HIGH_WIDTH=2.0
0DTE_DELTA_QQQ_MED_DELTA=0.25
0DTE_DELTA_QQQ_MED_WIDTH=1.0
0DTE_DELTA_QQQ_LOW_DELTA=0.15
0DTE_DELTA_QQQ_LOW_WIDTH=1.0
0DTE_DELTA_SPY_HIGH_DELTA=0.30
0DTE_DELTA_SPY_HIGH_WIDTH=2.0
0DTE_DELTA_SPY_MED_DELTA=0.25
0DTE_DELTA_SPY_MED_WIDTH=1.0
0DTE_DELTA_SPY_LOW_DELTA=0.15
0DTE_DELTA_SPY_LOW_WIDTH=1.0
0DTE_DELTA_OTHER_HIGH_DELTA=0.35
0DTE_DELTA_OTHER_HIGH_WIDTH=2.0
0DTE_DELTA_OTHER_MED_DELTA=0.25
0DTE_DELTA_OTHER_MED_WIDTH=1.0
0DTE_DELTA_OTHER_LOW_DELTA=0.15
0DTE_DELTA_OTHER_LOW_WIDTH=1.0

# Structure / strategy selection boosts (directional strength toward debit_spread vs alternatives)
0DTE_STRATEGY_BOOST_MIN_VOLUME_RATIO=1.35
0DTE_STRATEGY_BOOST_VOLUME_POINTS=6.0
0DTE_STRATEGY_BOOST_MIN_CONFIDENCE=0.88
0DTE_STRATEGY_BOOST_CONFIDENCE_POINTS=6.0
0DTE_STRATEGY_BOOST_MIN_ORB_RANGE_PCT=0.35
0DTE_STRATEGY_BOOST_ORB_POINTS=4.0
0DTE_STRATEGY_BOOST_MIN_VWAP_DIST=0.30
0DTE_STRATEGY_BOOST_VWAP_POINTS=4.0

# Strong / moderate / weak tier gates (structure selection — momentum_confidence_volume_eligibility)
0DTE_STRONG_MOMENTUM_MIN=70.0
0DTE_STRONG_BREAKOUT_DISTANCE_RATIO_MIN=0.08
0DTE_STRONG_MIN_CONFIDENCE=0.72
0DTE_STRONG_MIN_VOLUME_RATIO=1.05
0DTE_MODERATE_MOMENTUM_MIN=55.0
0DTE_MODERATE_BREAKOUT_DISTANCE_RATIO_MIN=0.02
0DTE_MODERATE_MIN_CONFIDENCE=0.58
0DTE_MODERATE_MIN_VOLUME_RATIO=0.90
0DTE_WEAK_MOMENTUM_MAX=50.0
0DTE_WEAK_BREAKOUT_DISTANCE_RATIO_MAX=0.015
0DTE_WEAK_MIN_CONFIDENCE=0.55
0DTE_WEAK_MIN_ELIGIBILITY=0.72

# -----------------------------------------------------------------------------
# 6) Execution gating & runtime checks
# -----------------------------------------------------------------------------
0DTE_MIN_RISK_REWARD=0.20
0DTE_MIN_MAX_PROFIT_PER_SPREAD=0.15
0DTE_MAX_DEBIT_TO_WIDTH_PCT=0.92
0DTE_PREENTRY_MIN_EXPECTED_MOVE_PCT=0.004
0DTE_PREENTRY_ORB_RANGE_WEIGHT=0.80
0DTE_PREENTRY_FEASIBILITY_MULT=1.50
# Watch-mode execute clock = DISCOVERY_ORB1_TL0_* (Shared.env §5). Do not set a second ET window.
# Batch SC rollback only: 0DTE_HARD_GATE_ET_START / _END (unset → 10:30–10:40 ET).
0DTE_HARD_GATE_WIDE_ORB_WARN_PCT=2.0
0DTE_HARD_GATE_MAX_SPREAD_PCT=5.0
0DTE_HARD_GATE_VOLUME_MULTIPLIER=1.0
# Rev 00368 (May 27): cap Hard Gate volume at continuation vol floor (not Convex — pc_oi only)
0DTE_HARD_GATE_ALIGN_CONTINUATION_VOL=true
0DTE_HARD_GATE_CONTINUATION_VOL_FLOOR=0.012
0DTE_HARD_GATE_BREAKDOWN_VOL_FLOOR=0.012
0DTE_HARD_GATE_BASE_INDICES=SPY,QQQ,IWM,SPX
0DTE_SYMBOLS_FALLBACK=SPX,QQQ,SPY
# Chain health precheck & relaxed pass (prime_trading_system execution path)
# Viability queue → execution batch (same module as chain health)
# ORB1 Breakout overextension (soft penalty + extreme hard reject) — May 11 audit
# Pre-final chain-health: extra target-delta ladder (comma-separated offsets from signal target_delta)
ORB_0DTE_EXIT_GRADE_MIN_GOOD_TICKS=3
0DTE_DIRECTIONAL_SKEW_WARN_THRESHOLD=0.80
ORB_0DTE_DURABILITY_RECONCILE_WAIT_SECONDS=75
# Thin-chain relax: allow prequeue pass when Convex eligibility is high and at least one ATM-quoted leg exists
ORB_0DTE_CHAIN_HEALTH_RELAX_MIN_ELIGIBILITY=0.76
ORB_0DTE_CHAIN_HEALTH_THIN_ATM_MAX_ABS_DIST=6.0
ORB_0DTE_CHAIN_HEALTH_THIN_ATM_MAX_PCT_DIST=0.012
# Signal collection diagnostics
0DTE_OMISSION_LOG_MAX=60
# Options position monitor cadence & degraded telemetry (prime_trading_system — ORB1 Breakout books)
ORB_OPTIONS_MONITOR_HEARTBEAT_SEC=90
# Per-trade ORB_0DTE_POSITION_LIFECYCLE_SNAPSHOT throttle (seconds); grep token ORB_0DTE_POSITION_LIFECYCLE_SNAPSHOT
ORB_0DTE_LIFECYCLE_SNAPSHOT_LOG_SEC=60
# Optional Telegram: ORB_0DTE_POSITION_STATUS_HEARTBEAT on same cadence as ORB_OPTIONS_MONITOR_HEARTBEAT_SEC (system alert)
ORB_0DTE_POSITION_STATUS_HEARTBEAT_ALERT=false
ORB_OPTIONS_MONITOR_NO_EXIT_DIAG_LOG_SEC=180
ORB_OPTIONS_MONITOR_STALE_WARN_SEC=300
# Quote health + kill switch: canonical 0DTE_DEGRADED_* in Account0DTE.env (shared ORB+TL).
# Legacy aliases below kept for older readers / logs.
ORB_OPTIONS_MONITOR_DEGRADED_WARN_RATIO=0.60
ORB_OPTIONS_MONITOR_DEGRADED_WARN_CONSECUTIVE=3
ORB_0DTE_MONITOR_WATCHDOG_SECONDS=20
ORB_0DTE_EXIT_CONFIRMATION_TIMEOUT_SECONDS=15
ORB_0DTE_LIVE_BLOCK_DEGRADED_ENTRY=true
ORB_0DTE_LIVE_MAX_QUOTE_AGE_SECONDS=10
ORB_0DTE_DEGRADED_ENTRY_KILL_SWITCH_ENABLED=true
ORB_0DTE_DEGRADED_ENTRY_KILL_SWITCH_RATIO=0.60
ORB_0DTE_DEGRADED_ENTRY_KILL_SWITCH_CONSECUTIVE=3
# Freshness / exit quotes

# Unified 0DTE position monitor (ORB + Trendline) — one cadence knob for both paths
ORB_0DTE_DEBUG_VERBOSE=false
OPTION_MONITOR_ISOLATE_POSITION_EXCEPTIONS=true
# Exit-grade bypass for singles: Shared.env §2b OPTION_SINGLE_EXIT_GRADE_BYPASS
OPTION_LIFECYCLE_TICK_LOG_SEC=15
ORB_0DTE_UNCLOSABLE_ALERT_AFTER_SEC=120

# ORB1 Breakout spread: degraded quote / partial_leg exit relief (prime_options_stealth_trailing_tp — prevents indefinite DEGRADED_DATA_HOLD)
ORB_OPTIONS_SPREAD_DEGRADED_EXIT_ENABLE=true
ORB_OPTIONS_SPREAD_CONSERVATIVE_EXIT_ENABLE=true
ORB_SPREAD_CONSERVATIVE_EXIT_MIN_TRADE_MINUTES=5
ORB_SPREAD_CONSERVATIVE_EXIT_MIN_PARTIAL_MINUTES=4
ORB_SPREAD_CONSERVATIVE_EXIT_MIN_DEFERRALS=15
ORB_SPREAD_CONSERVATIVE_EXIT_MAX_LEG_AGE_SECONDS=240
ORB_SPREAD_FORCED_DEGRADED_EXIT_MIN_TRADE_MINUTES=28
ORB_SPREAD_FORCED_DEGRADED_MIN_PARTIAL_LEG_MINUTES=20
ORB_SPREAD_FORCED_DEGRADED_MIN_DEFERRALS=55
ORB_SPREAD_FORCED_DEGRADED_WATCHDOG_ACCUM_SECONDS=480
ORB_SPREAD_FORCED_DEGRADED_ABS_MAX_MINUTES=90
ORB_SPREAD_FORCED_ALLOW_INCOMPLETE_MTM=true

