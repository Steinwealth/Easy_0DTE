# =============================================================================
# Account0DTE.env — unified 0DTE account, portfolio risk, broker routing, live execution
# =============================================================================
# Loaded after: ORBPipeline.env · before: ProfitCapture.env
# (Former filename: Account0DTE.env — keys unchanged; UNIFIED_0DTE_* prefix retained in code)
#
# SECTION TAXONOMY (see configs/README.md · docs/0DTERisk.md)
#   1  Account & demo ledger
#   2  Unified portfolio risk (Unified0DTEPortfolioRiskManager)
#   3  Multi-broker routing (BrokerRouter)
#   4  Live entry execution risk (dte0_execution_risk_manager)
#   5  Live close hardening
#
# Cap glossary (canonical keys — leftovers kept as code aliases only):
#   TOTAL_0DTE_MAX_POSITIONS     = combined open-count across ORB1 + ORB2 + Trendline (one variable)
#   0DTE_SLOT_COUNT              = equal-slot sizing divisor — MUST equal TOTAL_0DTE_MAX_POSITIONS
#   ORB_0DTE_MAX_POSITIONS       = ORB1 Breakout rolling open-count
#   BREAKOUT_0DTE_MAX_POSITIONS  = ORB2 Breakout rolling open-count
#   TRENDLINE_0DTE_MAX_POSITIONS = Trendline rolling open-count
#   0DTE_MONITOR_MAX_SYMBOLS     = post-fill monitor universe (match total)
#   0DTE_DEGRADED_*              = quote-health warn + entry kill switch
# Do not set MAX_OPEN_POSITIONS (Prime leftover of TOTAL) / UNIFIED_0DTE_*_MAX_POSITIONS /
# MAX_TOTAL_OPTION_POSITIONS / TRENDLINE_SLOT_COUNT / TRENDLINE_MAX_OPEN_POSITIONS /
# ORB_0DTE_PRIORITY_RANK_FINAL_BATCH_MAX.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Account & demo ledger — ORB1 Breakout + Trendline 0DTE (one balance, one book)
# -----------------------------------------------------------------------------
0DTE_DEMO_STARTING_BALANCE=100000
0DTE_TRADING_CAPITAL_PCT=90
# Live closed-trade ledger hygiene (GCS live_options_history.json). 0 = no max.
LIVE_OPTIONS_LEDGER_MAX_CLOSED_TRADES=400
# Demo unified options ledger hygiene (GCS mock_options_history.json). 0 = no max.
MOCK_OPTIONS_LEDGER_MAX_CLOSED_TRADES=400
# Safety ceiling only. Demo: 7 slots, no dollar sum cap, no contract-count cap.
# Size is 1/7 of the 90% tradable pool. The 35% ceiling is looser than that slot.
0DTE_MAX_POSITION_SIZE_PCT=35
# Optional absolute per-position cap (USD). 0 / off / NA = no dollar sum cap.
# Eric 10/9/2026: $600 max sum per new position (Demo $100k reseed).
0DTE_MAX_POSITION_SIZE_SUM=600
# Equal-slot sizing divisor (ORB1 + ORB2 + Trendline share tradable / N).
# MUST equal TOTAL_0DTE_MAX_POSITIONS so each open is 1/N of deployable cash.
0DTE_SLOT_COUNT=50
# Combined 0DTE open-count (ORB1 + ORB2 + Trendline). One variable.
TOTAL_0DTE_MAX_POSITIONS=50
# Monitor up to N distinct underlyings (match combined book).
0DTE_MONITOR_MAX_SYMBOLS=50

# -----------------------------------------------------------------------------
# 2) Unified portfolio risk (ORB1 + ORB2 + Trendline account-level gates)
# -----------------------------------------------------------------------------
UNIFIED_0DTE_RISK_ENABLED=true
# ORB1 Breakout rolling open-count
ORB_0DTE_MAX_POSITIONS=50
# ORB2 Breakout rolling open-count
BREAKOUT_0DTE_MAX_POSITIONS=50
# Trendline 0DTE rolling open-count (not 0DTE_SLOT_COUNT)
TRENDLINE_0DTE_MAX_POSITIONS=50
UNIFIED_0DTE_FAIL_CLOSED=true
UNIFIED_0DTE_LOG_AUDIT=true
UNIFIED_0DTE_BROKER_BALANCE_CACHE_MAX_AGE_SEC=120

# -----------------------------------------------------------------------------
# 2b) Quote health + entry kill switch (ORB + Trendline post-fill monitors)
# Legacy ORB_OPTIONS_MONITOR_DEGRADED_* / ORB_0DTE_DEGRADED_ENTRY_KILL_SWITCH_* alias these.
# -----------------------------------------------------------------------------
0DTE_DEGRADED_WARN_RATIO=0.60
0DTE_DEGRADED_WARN_CONSECUTIVE=3
0DTE_DEGRADED_ENTRY_KILL_SWITCH_ENABLED=true
0DTE_DEGRADED_ENTRY_KILL_SWITCH_RATIO=0.60
0DTE_DEGRADED_ENTRY_KILL_SWITCH_CONSECUTIVE=3

# -----------------------------------------------------------------------------
# 3) Multi-broker routing (BrokerRouter)
# -----------------------------------------------------------------------------
BROKER_ACCOUNTS_JSON=
DEFAULT_0DTE_BROKER_ACCOUNT_ID=etrade_primary

# -----------------------------------------------------------------------------
# 4) Live entry execution risk (ORB + Trendline lotto opens)
# Spread caps: path-owned via modules/spread_policy.py (ORB 8% · Trendline 30%)
# Do not set LIVE_MAX_SPREAD_PCT — removed (was global MIN that blocked Trendline).
# Oct 13 2026 — canonical spread rule, read ONLY when SINGLE_TP_ADMIT=true (flag off: legacy ORB 8 / TL+BO 30).
# Unit: % points of mid ((ask-bid)/mid*100). Enforced in the shared picker + re-checked at submit.
# Per path (Eric 10/13): ORB1 8 · Breakout 30 · Trendline 30. Base below only if a path key is unset.
0DTE_MAX_SPREAD_PCT=8.0
0DTE_MAX_SPREAD_PCT_ORB1=8.0
0DTE_MAX_SPREAD_PCT_BREAKOUT=30.0
0DTE_MAX_SPREAD_PCT_TRENDLINE=30.0
# Cheap-contract allowance: pass when ask-bid <= this many dollars (0.01 = one tick), whatever the %.
0DTE_SPREAD_CHEAP_MAX_USD=0.01
# -----------------------------------------------------------------------------
# Liquidity / ADV Guard (does NOT replace Position Sizing). Upstream still sizes from
# 90% tradable / 7 equal slots. These caps only bind when slot qty would exceed
# market-executable limits. 0 / none = no contract-count cap. No dollar sum cap.
LIVE_MAX_CONTRACTS_PER_TRADE=0
# v1.6: volume qty cap off (0 = disabled; no fail-closed on missing volume).
LIVE_OPTION_VOLUME_PARTICIPATION_PCT=0
# 0 = no contract-count floor. Volume pct is off, so this must not force a minimum.
LIVE_OPTION_VOLUME_MIN_CONTRACTS=0
# v1.5/v1.6: OI is not a qty cap (0 = disabled; no fail-closed on missing OI).
LIVE_OPTION_OI_PARTICIPATION_PCT=0
# Sep 9: ask-depth qty cap OFF (0). Was v1.7 temporary 200% of displayed ask.
LIVE_OPTION_BOOK_DEPTH_PARTICIPATION_PCT=0
# v1.5/v1.6: bid is MQ evidence only. Shared min bid/ask size lives in Shared.env.
LIVE_OPTION_EXIT_BOOK_DEPTH_PARTICIPATION_PCT=0
# Underlying ADV: option notional (qty×ask×100) ≤ ADV_dollars × pct. Fail-closed if ADV unknown when pct > 0.
LIVE_UNDERLYING_ADV_PARTICIPATION_PCT=0.02
# Broker-token-first ADV$ (E*TRADE averageVolume×last). Yahoo only if true.
# 0 = no generic watchlist floor (fail-closed after broker + named floors).
LIVE_REFRESH_QUOTES_BEFORE_SUBMIT=true
# Reuse select-time / manager-cache chain when age ≤ N seconds and leg has
# bid/ask/vol/OI/bid_size/ask_size. Older or incomplete → force broker fetch.
LIVE_QUOTE_REFRESH_CACHE_MAX_AGE_SEC=5
# Demo: enforce the same liquidity clamps as Live (slot sizing still primary).
# Spread / market-quality gate always enforced when OPTION_TRUE_TO_LIVE_EXECUTABLE_MARKS=true (default).
LIVE_SIZE_CAP_ENFORCE_IN_DEMO=true

# -----------------------------------------------------------------------------
# 5) Live close hardening (ORB1 Breakout + Trendline 0DTE)
# -----------------------------------------------------------------------------
LIVE_CLOSE_MAX_ATTEMPTS=3
LIVE_CLOSE_RETRY_INTERVAL_SEC=0.75
LIVE_CLOSE_RETRY_BACKOFF_MULTIPLIER=1.5
EXEC_ENTRY_FILL_RECONCILE_TIMEOUT_SEC=4
EXEC_EXIT_FILL_RECONCILE_TIMEOUT_SEC=10
