# =============================================================================
# Trendline0DTE.env — Trendline 0DTE path (simple break mode, build, caps, exits)
# =============================================================================
# Path section groups (same seven titles as ORB0DTE.env; ORB pipeline in ORBPipeline.env):
#  1 Path toggle & scope
#  2 ORB & session timing
#  3 Eligibility, scoring & filters (selector v3 + TRENDLINE_* (post-draw))
#  4 Position sizing & capital
#  5 Instruments, spreads & liquidity
#  6 Execution gating & runtime checks (7:30 build budgets)
#  7 Profit capture & monitoring (path ladder; live stealth → ProfitCapture.env OPTION_STEALTH_TLINE_*)
# See configs/README.md · docs/Configs.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Path toggle & scope
# -----------------------------------------------------------------------------
ENABLE_TRENDLINE_STRATEGY=true
TRENDLINE_USE_FULL_0DTE_LIST=true

# -----------------------------------------------------------------------------
# 2) ORB & session timing
# -----------------------------------------------------------------------------
# Clocks: Shared.env §5 (DISCOVERY_ORB1_TL0_* · DISCOVERY_ORB2_TL_* · ORB_WINDOW_*).
# TL0 discovery/geometry = ORB1 window. TL1–TL3 discovery/entries = ORB2 window.
TRENDLINE_FUNNEL_SUMMARY_INTERVAL_SEC=180
TRENDLINE_FALSE_BREAK_GATE_LOG_THROTTLE_SEC=60
TRENDLINE_MAX_ACTIVE_MINUTES=180
# TL1–TL10: only first-break activate within this many seconds of draw/inject (built_at). After → EXPIRED.
# TL0 hard-expires at DISCOVERY_ORB1_TL0_END_PT (07:25 PT) instead of this clock.
TRENDLINE_TRADE_ACTIVATE_MAX_AGE_SEC=10800
# TL1+ geometry live window from draw/inject (3h). One reject or fill expires that slot/side envelope.
TRENDLINE_MIN_STRUCTURE_BARS=3
TRENDLINE_MIN_STRUCTURE_SECONDS=180
TRENDLINE_MIN_ANCHOR_DISTANCE_MINUTES=5
# Demo balance: Account0DTE.env 0DTE_DEMO_STARTING_BALANCE (do not duplicate here)
# Discovery cadence/batch owned by Shared.env 0DTE_DISCOVERY_* (unified ORB1+TL+BO scan).
TRENDLINE_WATCH_YIELD_EVERY_N=12

# -----------------------------------------------------------------------------
# 3) Pre-draw selector / build + simple post-draw break mode
# -----------------------------------------------------------------------------
# Aug 12 prune: accurate A1/A2 envelope is the TL1 winner path. Legacy v3 / MSE /
# extreme-ORB prefer / ATR nearline / identity overlays removed from operator env.
TRENDLINE_PRIMARY_LANE_ENFORCE_GEOMETRY_ALIGNMENT=true
TRENDLINE_ORB_BIAS_MSE_SOFT_RATIO=8.0
# Geometry Phase 1 — envelope-only TL1 contest (selection; does not change break/entry gates)
TRENDLINE_GEOMETRY_PHASE1_ENABLED=true
# Oct 13: per-candidate TRENDLINE_DRAW_AUDIT / TRENDLINE_STRUCTURE_COMPARISON (DEBUG) — off by default
TRENDLINE_GEOMETRY_AUDIT_LOGS=false
TRENDLINE_MAX_LINE_DISTANCE_AT_CUTOFF_PCT=0.02
TRENDLINE_MAX_LINE_DISTANCE_VOLATILITY_ADJUST=false
# TL0–TL3 shared envelope (ORB extreme → steepest outside hull; never pin A2 to 7:30 close)
TRENDLINE_PRE730_STRUCTURE_ENVELOPE_ENABLED=true
TRENDLINE_PRE730_ENVELOPE_WICK_BUFFER_PCT=0.0005
TRENDLINE_PRE730_ENVELOPE_MIN_ANCHOR_SECONDS=60
TRENDLINE_GEOMETRY_SKIP_TREND_CONTINUATION=true
# Post-draw break mode — sole detect/emit floor (stock + index unified).
# TRENDLINE_MIN_BREAK_DISTANCE_PCT=0.0008 (0.08%). Continuation key deleted.
# Detect stays close-based (wick-through that closes back is a fake). Quality admits or rejects.
TRENDLINE_BREAK_MODE=true
TRENDLINE_MIN_SCORE=55
TRENDLINE_MIN_BREAK_DISTANCE_PCT=0.0008
# Trendline2/3 — ORB2 material-extension envelopes (does not change Trendline1)
TRENDLINE_ORB2_EXTENSION_ENVELOPE_ENABLED=true
TRENDLINE_ORB2_ENVELOPE_WICK_BUFFER_PCT=0.0005
TRENDLINE_ORB2_ENVELOPE_MIN_BREAK_DISTANCE_PCT=0.0015
TRENDLINE_ORB2_ENVELOPE_MIN_ANCHOR_SECONDS=60
# Re-arm next TL only after a 1m close ≥ max(this, min_break 0.15%) into the box.
# Also required before the *first* TL2 when price was already outside ORB2 at 07:30
# (KTOS 2026-08-25): TL1 keeps the envelope until that reclaim, then a later break.
# AMD 2026-08-18: 477.495 vs ORB2 low 477.46 was +0.007% — must not clear TL3.
# IBIT 2026-08-24: 45.080 vs ORB2 high 45.1187 was +0.086% — also same episode
# once the floor is lifted to the 0.15% material-break distance.
TRENDLINE_ORB2_RECLAIM_INSIDE_PCT=0.0008
# RSI is GATE_TL_RSI=observe until the fill book locks levels (not a hard reject).
# Stamp bands CALL≤80 / PUT≥20 are side-agnostic: Aug 13 NVDA PUT RSI~43 at 07:43
# admits; CALL mirror is ~57 (100−43) which is also inside ≤80. Vol floor below.
# VWAP admit is GATE_TL_VWAP=observe only (below).
# Entry distance scaffolding only (no hard reject); QG anti-chase owns extension
TRENDLINE_MAX_ENTRY_DISTANCE_PCT=0.05
TRENDLINE_ENTRY_WINDOW_SEC=300
# Exec-ready TTL while waiting for a slot (QUALITY_CONFIRMED / READY). Default from
# Shared.env 0DTE_EXEC_SIGNAL_EXPIRE_MINUTES=1. Uncomment to override this path only.
# TRENDLINE_EXEC_SIGNAL_EXPIRE_MINUTES=1
TRENDLINE_ENFORCE_GEOMETRY_SIDE=true

# -----------------------------------------------------------------------------
# 4) Position sizing & capital (shared 0DTE slot pool — Account0DTE.env)
# Canonical sizing: 0DTE_SLOT_COUNT (7). Canonical TL open-count:
# TRENDLINE_0DTE_MAX_POSITIONS (7). Combined book: TOTAL_0DTE_MAX_POSITIONS (7).
# Do not re-set TRENDLINE_SLOT_COUNT / TRENDLINE_MAX_OPEN_POSITIONS here.
# Monitor: Account0DTE.env 0DTE_MONITOR_MAX_SYMBOLS.
# Deployable capital % = Account0DTE.env 0DTE_TRADING_CAPITAL_PCT (90).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# 5) Instruments, spreads & liquidity
# -----------------------------------------------------------------------------
# Shared entry policy lives in Shared.env (0DTE_ENTRY_DELTA_*, premiums, volume/OI, bid/ask size).
TRENDLINE_OPTION_STRIKE_MODE=otm_1_to_2
TRENDLINE_OPTION_LOTTO_MODE=true
TRENDLINE_OPTION_MAX_SPREAD_PCT=0.30
# True-to-live safety: block synthetic chain fallback unless explicitly enabled (default off).
TRENDLINE_ALLOW_SYNTHETIC_ENTRY=false
TRENDLINE_DELTA_TOLERANCE=0.02
# Jul 28 shared OTM lock (≤5.5%) — same as ORB/BO Layer D
TRENDLINE_OTM_GATE_ENABLED=true
TRENDLINE_PREFER_MAX_OTM_PCT=0.055
TRENDLINE_RESEARCH_MAX_OTM_PCT=0.055
TRENDLINE_OPTION_SENSITIVITY=2.5

# -----------------------------------------------------------------------------
# 6) Execution gating & runtime checks (build path)
# -----------------------------------------------------------------------------
# Red Day Portfolio Protection — mirror ORB1 Breakout Step 5 (Tier 1 CALL + all PUT; block Tier 2+ CALL).
TRENDLINE_RED_DAY_GATE_ENABLED=true
TRENDLINE_RED_DAY_ALLOW_TIER1_CALL=true
TRENDLINE_RED_DAY_ALLOW_PUT=true
# First TL watch tick after TL1 unlock (watch mode). Legacy SC batch mode still waits for Step 5 Telegram order when not in watch mode.
TRENDLINE_DEFER_POST_BUILD_WATCH_UNTIL_ORB_BATCH=true
# Arm once at ORB1 cutoff (07:10); run single-flight TL1 build after ORB2. Watch/emits unlock with that release.
# TL0 builds separately after ORB1 ≥06:45 secure (ORB1 H/L dual-side); keys SYM:*:trendline0.
TRENDLINE_DEFER_BUILD_UNTIL_ORB_BATCH=true
# Runtime gate: ENABLE_TRENDLINE_STRATEGY (Shared.env / main.py)
# Quality Gate Stack — Layer C via stack; A/B cutover at quality emit (no chain fetch at emit)
QUALITY_GATE_STACK_SHADOW=true
QUALITY_GATE_STACK_CUTOVER=true
# --- Path-opt TL-QG-LS1 — operator admit keys (internal stack IDs unchanged) ---
# VWAP observe · RSI observe CALL≤80/PUT≥20 (stamp only until fill book) ·
# BB observe CALL≤70/PUT≥30 · vol≥0.012 hard · dir%>0.10 (TL0–TL3 only)
GATE_TL_VWAP=observe
QG_TL_VWAP_REJECT_AT=true
GATE_TL_RSI=observe
QG_TL_RSI_CALL_MAX=80
QG_TL_RSI_PUT_MIN=20
GATE_TL_BB=observe
QG_TL_BB_CALL_MAX=70
QG_TL_BB_PUT_MIN=30
GATE_TL_Vol_Ratio=hard
GATE_TL_Vol_Ratio_MIN=0.012
# Research wide collect (Eric 10/9/2026; QUALITY_GATE_ADMIT=wide_collect in Shared.env).
# Restored from the Sep 17 wide-collect config (git HEAD): dir% >0.10 hard, vol floor hard,
# break_max 2.50 hard, pc_oi off. Trade Profile runs in observe (stamps only).
GATE_TL_dir_pct=hard
TRENDLINE_DIR_VOLUME_PCT=0.10
# TL0 06:45–07:10: ratio/RSI often not on the first bars. Missing skips admit.
# Measured vol still hard vs 0.012. Side gates stay on the Trade Profile.
TL_VOLUME_MISSING_FAIL_CLOSED=false
# Skip Signals (levels in Shared.env). CALL/PUT stay hard; Path SS off (more book).
# Absolute CALL/PUT: GATE_*_call_ss / put_ss. Strategy/side 0-MFE: GATE_*_path_ss.
# Eric 10/9 17:16 PT: CALL/PUT Skip Signals ON (hard) on wide collect. Path SS stays off (Sep 4 wide collect).
GATE_TL_call_ss=hard
GATE_TL_put_ss=hard
GATE_TL_path_ss=off
# Research stamps (observe until levels locked — not admit knives)
GATE_TL_RSI_stamp=observe
GATE_TL_MACD=observe
GATE_TL_BB_upper=observe
GATE_TL_BB_middle=observe
GATE_TL_BB_lower=observe
GATE_TL_BB_width=observe
GATE_TL_BB_pctB=observe
GATE_TL_call_vol=observe
GATE_TL_put_vol=observe

TRENDLINE_MIN_EXPECTED_MOVE_PCT=0.0015
TRENDLINE_DATA_CHUNK_SIZE=25
TRENDLINE_MAX_INTRADAY_BATCH_CALLS_PER_BUILD=8
TRENDLINE_MAX_QUOTE_BATCH_CALLS_PER_BUILD=8
TRENDLINE_MAX_SYMBOLS_PER_BUILD=200
TRENDLINE_ENABLE_BUILD_DEGRADATION=true
TRENDLINE_MAX_BUILD_DURATION_MS=0
# TL1 A2 structure path: batched Yahoo RTH 1m [06:30-07:30] PT.
TRENDLINE_BUILD_YF_1M_BACKFILL=true
TRENDLINE_BUILD_YF_1M_MAX_SYMBOLS=150
TRENDLINE_BUILD_YF_1M_BATCH_SIZE=20
TRENDLINE_BUILD_YF_1M_BATCH_SLEEP_SEC=0.5
# TL2/TL3 watch hydrate: batched Yahoo RTH 1m when cache is empty/thin.
TRENDLINE_WATCH_YF_1M_BACKFILL=true
TRENDLINE_WATCH_YF_1M_MIN_BARS=15
TRENDLINE_WATCH_YF_1M_MAX_SYMBOLS=150
TRENDLINE_WATCH_YF_1M_BATCH_SIZE=20
TRENDLINE_WATCH_YF_1M_BATCH_SLEEP_SEC=0.5
TRENDLINE_WATCH_YF_1M_MAX_STALE_SEC=180
TRENDLINE_WATCH_YF_1M_SYMBOL_COOLDOWN_SEC=300
TRENDLINE_WATCH_YF_1M_NEAR_BREAK_BUFFER_PCT=0.0010
# Pending TL2+ inject still bypasses the 5 min cooldown, but not every watch tick.
TRENDLINE_WATCH_YF_1M_FORCE_COOLDOWN_SEC=60
TRENDLINE_WATCH_HYDRATE_QUOTE_CAP=40
# Central Yahoo request manager for TL0/TL1/TL2+ watch/session-tech backfills.
YAHOO_BACKFILL_MANAGER_ENABLED=true
YAHOO_BACKFILL_PACING_ENABLED=true
YAHOO_BACKFILL_MAX_DOWNLOADS_PER_MIN=30
YAHOO_BACKFILL_MAX_CONCURRENT_DOWNLOADS=1
YAHOO_BACKFILL_COALESCE_MS=1200
YAHOO_BACKFILL_CACHE_TTL_SEC=120
YAHOO_BACKFILL_WATCH_CACHE_TTL_SEC=120
YAHOO_BACKFILL_BUILD_CACHE_TTL_SEC=1800
YAHOO_BACKFILL_MAX_PERIOD_DAYS=2
YAHOO_BACKFILL_MAX_CACHE_ENTRIES=400
YAHOO_BACKFILL_SLOW_MS=15000
YAHOO_BACKFILL_BACKOFF_BASE_SEC=2
YAHOO_BACKFILL_BACKOFF_MAX_SEC=20

# -----------------------------------------------------------------------------
# 7) Profit capture & monitoring (Trendline 0DTE)
# -----------------------------------------------------------------------------
# Live premium stealth: ProfitCapture.env OPTION_STEALTH_TLINE_* (+ TRENDLINE_TRAIL_* below as path helpers)
# Exit research (when enabled): ORBPipeline.env §4 PROFIT_OPTIMIZER_STALE_QUOTE_SECONDS / profit optimizer flags
TRENDLINE_EXIT_MIN_HOLD_SECONDS=240
# Monitor cadence: sole knob 0DTE_POSITION_MONITOR_INTERVAL_SEC in ORB0DTE.env / Shared.env (ORB + Trendline).
TRENDLINE_EXIT_CONFIRMATION_TIMEOUT_SECONDS=15
TRENDLINE_UNCLOSABLE_ALERT_AFTER_SEC=120
TRENDLINE_BREAKEVEN_ACTIVATE_PCT=0.22
TRENDLINE_BREAKEVEN_OFFSET_PCT=0.03
TRENDLINE_TRAIL_ACTIVATE_PCT=0.28
TRENDLINE_TRAIL_GIVEBACK_PCT=0.22
TRENDLINE_IMPULSE_BREAKEVEN_ACTIVATE_PCT=0.18
TRENDLINE_IMPULSE_TRAIL_ACTIVATE_PCT=0.24
TRENDLINE_IMPULSE_TRAIL_GIVEBACK_PCT=0.14
TRENDLINE_SLOW_TREND_BREAKEVEN_ACTIVATE_PCT=0.30
TRENDLINE_SLOW_TREND_TRAIL_ACTIVATE_PCT=0.50
TRENDLINE_SLOW_TREND_TRAIL_GIVEBACK_PCT=0.35
TRENDLINE_RETEST_BREAKEVEN_ACTIVATE_PCT=0.25
TRENDLINE_RETEST_TRAIL_ACTIVATE_PCT=0.40
TRENDLINE_RETEST_TRAIL_GIVEBACK_PCT=0.30
TRENDLINE_GLOBAL_DAILY_CAP_ENABLED=true
TRENDLINE_GLOBAL_DAILY_CAP_FAIL_OPEN=true
TRENDLINE_GLOBAL_DAILY_CAP_NAMESPACE=trendline_daily_cap
# Oct 13 2026: skip GCS slot probing when in-process TL open >= cap; probe from local_open+1 (wraps). false = legacy 1..cap scan.
TRENDLINE_GLOBAL_DAILY_CAP_FAST_PATH=true
TRENDLINE_WATCH_STATUS_LOG_SEC=120
TRENDLINE_WATCH_NEARLINE_LOG_SEC=180
TRENDLINE_WATCH_IDLE_LOG_SEC=300
TRENDLINE_WATCH_EMPTY_QUOTES_LOG_SEC=60
TRENDLINE_BUILD_ANCHOR_LOG_MAX=15
TRENDLINE_CONFIRM_PENDING_LOG_SEC=120
