# =============================================================================
# Data.env — broker, watchlists, deployment (Phase 2 trim — Jun 18, 2026)
# =============================================================================
# Broker-only data policy (Rev 00236). No third-party providers.
# Supported brokers: etrade (live). IB / TastyTrade placeholders remain below.
# Secrets: secretsprivate/ or Google Secret Manager
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Data policy & primary broker
# -----------------------------------------------------------------------------
BROKER_TYPE=etrade
BROKER_DATA_ONLY=true
DEPLOYMENT_MODE=demo

# -----------------------------------------------------------------------------
# 2) E*TRADE accounts
# -----------------------------------------------------------------------------
ETRADE_ORB_ACCOUNT_ID=YOUR_ORB_ACCOUNT_ID
ETRADE_ORB_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
ETRADE_0DTE_ACCOUNT_ID=YOUR_0DTE_ACCOUNT_ID
ETRADE_0DTE_ACCOUNT_NAME=
ETRADE_DEFAULT_ACCOUNT_ID=YOUR_ORB_ACCOUNT_ID
ETRADE_ENVIRONMENT=prod
ETRADE_ENABLED=true

# Market API pacing — E*TRADE 4 req/sec per OAuth user; tune via env on this service only.
ETRADE_BATCH_QUOTE_SIZE=25
ETRADE_MARKET_API_INTER_REQUEST_SEC=0.28

# -----------------------------------------------------------------------------
# 3) Interactive Brokers (placeholder)
# -----------------------------------------------------------------------------
IB_ENABLED=false
IB_ENVIRONMENT=paper

# -----------------------------------------------------------------------------
# 4) TastyTrade (placeholder)
# -----------------------------------------------------------------------------
TASTYTRADE_ENABLED=false
TASTYTRADE_ENVIRONMENT=demo

# -----------------------------------------------------------------------------
# 5) Watchlists
# -----------------------------------------------------------------------------
0DTE_WATCHLIST_PATH=data/watchlist/0dte_list.csv

# -----------------------------------------------------------------------------
# 6) Google Cloud & persistence
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=easy-etrade-strategy
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_SERVICE_NAME=easy-etrade-strategy
GCS_BUCKET_NAME=easy-etrade-strategy-data
GCS_PERSISTENCE_ENABLED=true
GCS_SESSION_RETENTION_DAYS=2
