{
  "name": "Trade Profile Wide (wide_collect admit as a Trade Profile)",
  "version": "wide",
  "status": "2026-10-13 final; loaded by easy0DTE/modules/single_tp_admit.py when SINGLE_TP_ADMIT=true and TRADE_PROFILE_VERSION=wide",
  "semantics": {
    "bounds": "inclusive unless min_strict/max_strict",
    "missing": "profile-driven (same mechanism as 10.5): missing_default=pass; a cell's missing_reject_keys reject when missing; missing_defer_keys hold (data_wait) like the legacy wide dir% defer; zero_is_missing below",
    "missing_defer": "call_share/put_share missing -> data_wait inside DIR_PCT_DEFER_MAX_WAIT_SEC, then data_unavailable (no cooldown)",
    "zero_is_missing": [
      "dir_pct_change_5m",
      "spy_change_pct"
    ],
    "extensions": [
      "equity_volume_ratio"
    ],
    "outside_tp": {
      "skip_signals": "GATE_call_ss / GATE_put_ss stay a separate hard Must-Execute check",
      "contract_picker": "premium 0.03-2.50, |delta| 0.18-0.42, OTM <= 0.055 (Breakout 0.035), vol/OI, spread: one shared picker",
      "geometry": "orb_break/orb_range/regime/tl_break/bo_confirm: signal definition",
      "capacity": "max open 50, $600 cap, TL slots, cooldowns"
    },
    "missing_default": "pass",
    "missing_reject": "equity_volume_ratio missing rejects (legacy GATE_Vol_Ratio required_session_data_error); break_distance_pct missing passes (legacy break_max skip 'absent')"
  },
