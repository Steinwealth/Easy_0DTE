# Easy 0DTE Strategy Configuration (reference / tooling)
# ======================================================
# The integrated Easy ORB app loads configs from repo root `configs/*.env` via
# ConfigLoader (see configs/README.md). Keys such as ENABLE_0DTE_STRATEGY and
# 0DTE_* guardrails should match `configs/ORB0DTE.env` for production parity.
# This file is kept for the easy0DTE subtree, scripts, and human reference.

# Enable 0DTE Strategy (mirror configs/ORB0DTE.env when using integrated app)
ENABLE_0DTE_STRATEGY=true

# Trading mode — canonical key is MODE (see configs/Shared.env)
# Demo Mode: live broker data + simulated ledger
# Live Mode: live broker data + real broker account
MODE=demo
DEPLOYMENT_MODE=demo
DEMO_MODE_ENABLED=true

# Convex Eligibility Filter v2.5 (pc_oi + ORB range + symmetric side gates — see configs/ORB0DTE.env)
0DTE_CONVEX_ORB_RANGE_MIN=0.25
0DTE_CONVEX_V25_SYMMETRIC_ENABLED=true
0DTE_CONVEX_VWAP_EXTENSION_REJECT_PCT=15.0
0DTE_CONVEX_ORB_RANGE_MAX_PCT=5.5

# Position Limits (Mirror ORB Strategy)
# Rev 00231: Updated to match ORB Strategy risk parameters
0DTE_MAX_POSITIONS=15  # Max concurrent positions (canonical: configs/ORB0DTE.env)
# Note: 0DTE_MAX_POSITION_COST removed - using only 35% max position size (matches ORB Strategy)

# Debit Spread Settings (width only — spread primary disabled; delta targets removed)
0DTE_DEBIT_SPREAD_WIDTH_OPTIONS=1.0,2.0

# Lotto Sleeve Settings
0DTE_LOTTO_SLEEVE_ENABLED=false

# Options Chain Settings (mirror configs/ORB0DTE.env — canonical 8% via 0DTE_MAX_BID_ASK_SPREAD_PCT)
0DTE_OPTIONS_MIN_OPEN_INTEREST=100
0DTE_MAX_BID_ASK_SPREAD_PCT=8.0
0DTE_OPTIONS_MIN_VOLUME=50

# Chop momentum (mirror configs/Shared.env — Rev 00337)
0DTE_CHOP_MOMENTUM_MIN=40
0DTE_CHOP_MOMENTUM_MIN_CONVEX_BYPASS=35
0DTE_CHOP_CONVEX_BYPASS_MIN_ELIG=0.75
0DTE_CHOP_CONVEX_BYPASS_MIN_CONF=0.90
0DTE_ORB_TREAT_NEUTRAL_AS_GREEN=true
0DTE_ORB_TREAT_NEUTRAL_AS_RED=true
ORB_RTH_INTRADAY_SYMBOLS=VIX,SPX
# Mirror ORB0DTE.env / Shared.env — 0DTE PUT 7:30 execution vs ORB low (Rev 00341)
PUT_RECHECK_BREAKDOWN_MULTIPLIER=1.000

# Profit Management
0DTE_AUTO_PARTIAL_ENABLED=true
0DTE_PARTIAL_PROFIT_PCT=0.50
0DTE_RUNNER_PROFIT_PCT=2.0

# 0DTE universe: data/watchlist/0dte_list.csv (main.py uses target_symbols=None → full CSV).
# 0DTE_TARGET_SYMBOLS is NOT read by the integrated Python app — do not assume it limits VIX or other names.
# (Legacy reference only; scripts may parse this file by hand.)
# 0DTE_TARGET_SYMBOLS=SPY,QQQ,IWM

# ETrade Account Configuration (Rev 00245 - Jan 19, 2026)
# Separate account for 0DTE Options Trading
# Account ID: YOUR_0DTE_ACCOUNT_ID
# This account is dedicated to 0DTE options trading only
#
# NOTE: This setting is now managed by Data.env (ETRADE_0DTE_ACCOUNT_ID)
# Kept here for backward compatibility - Data.env takes precedence when merged by the app
0DTE_ETRADE_ACCOUNT_ID=YOUR_0DTE_ACCOUNT_ID

# ORB 0DTE tuning (priority tiers, delta ladder, rank multipliers):
# canonical values live in repo root `configs/ORB0DTE.env`.
# See `docs/ORB0DTE_Config_Reference.md` for the full key list and defaults.
